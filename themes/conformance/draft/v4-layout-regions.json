{
  "specVersion": 4,
  "uiKit": "shadcn",
  "light": {
    "background": "#f8fafc",
    "foreground": "#0f172a",
    "card": "#ffffff",
    "cardForeground": "#0f172a",
    "primary": "#2563eb",
    "primaryForeground": "#f8fafc",
    "secondary": "#ffffff",
    "secondaryForeground": "#0f172a",
    "muted": "#ffffff",
    "mutedForeground": "#0f172a",
    "accent": "#2563eb",
    "accentForeground": "#f8fafc",
    "destructive": "#dc2626",
    "destructiveForeground": "#ffffff",
    "border": "#334155",
    "input": "#334155",
    "ring": "#2563eb"
  },
  "dark": {
    "background": "#0f172a",
    "foreground": "#f8fafc",
    "card": "#1e293b",
    "cardForeground": "#f8fafc",
    "primary": "#60a5fa",
    "primaryForeground": "#0f172a",
    "secondary": "#1e293b",
    "secondaryForeground": "#f8fafc",
    "muted": "#1e293b",
    "mutedForeground": "#f8fafc",
    "accent": "#60a5fa",
    "accentForeground": "#0f172a",
    "destructive": "#dc2626",
    "destructiveForeground": "#ffffff",
    "border": "#334155",
    "input": "#334155",
    "ring": "#60a5fa"
  },
  "layout": {
    "sidebar": "theme",
    "sidebarWidth": 240,
    "aside": "theme",
    "asideWidth": 340,
    "responsive": {
      "compact": {
        "sidebar": "host",
        "aside": "none",
        "sidebarWidth": 180
      }
    }
  },
  "ui": {
    "slots": {
      "sidebar.content": {
        "children": [
          {
            "type": "text",
            "text": "Regions",
            "size": "lg",
            "weight": "bold"
          },
          {
            "type": "resizable",
            "direction": "horizontal",
            "initial": 200,
            "min": 120,
            "max": 360,
            "storageKey": "regions.shelf",
            "children": [
              {
                "type": "text",
                "text": "Pinned"
              },
              {
                "type": "text",
                "text": "Recent"
              }
            ]
          },
          {
            "type": "button",
            "label": "Collapse sidebar",
            "action": {
              "type": "toggleSidebar"
            }
          }
        ]
      },
      "sidebar.library": {
        "children": [
          {
            "type": "text",
            "text": "Your library"
          },
          {
            "type": "button",
            "label": "Toggle regions",
            "action": {
              "type": "toggleRegion",
              "args": {
                "id": "sidebar"
              }
            }
          }
        ]
      },
      "aside.content": {
        "children": [
          {
            "type": "text",
            "text": "Now playing",
            "size": "sm",
            "color": "@mutedForeground"
          },
          {
            "type": "text",
            "bind": "player.title",
            "size": "lg",
            "weight": "bold"
          },
          {
            "type": "text",
            "bind": "player.artist",
            "color": "@mutedForeground"
          },
          {
            "type": "button",
            "label": "Close panel",
            "action": {
              "type": "toggleAside"
            }
          }
        ]
      },
      "library.local.content": {
        "children": [
          {
            "type": "text",
            "text": "Local folders",
            "size": "lg",
            "weight": "bold"
          },
          {
            "type": "list",
            "bind": "library.folders",
            "children": [
              {
                "type": "text",
                "bind": "item.name"
              }
            ]
          }
        ]
      }
    }
  }
}
