      "radio",
      "stats",
      "search"
    ],
    "navbarItems": [
      "home",
      "search",
      "radio",
      "library",
      "stats"
    ],
    "libraryItems": [
      "playlists",
      "artists",
      "albums",
      "local_library"
    ],
    "player": {
      "dock": "stage",
      "showTrackDetails": true,
      "showActions": true,
      "showVolume": true,
      "showLyrics": true,
      "showProgress": true
    },
    "home": {
      "sections": [
        "recent",
        "featured",
        "new_releases",
        "browse"
      ]
    },
    "settings": {
      "sections": [
        "accounts",
        "language_region",
        "appearance",
        "sidebar",
        "playback",
        "downloads",
        "desktop",
        "developers",
        "about"
      ]
    },
    "titlebar": {
      "height": 40.0,
      "padding": 12.0,
      "showBack": true
    },
    "splash": {
      "text": "Kitchen Sink"
    },
    "enforce": [
      "playerDock"
    ],
    "responsive": {
      "compact": {
        "nav": "rail",
        "navItems": [
          "home",
          "radio",
          "stats"
        ],
        "player": {
          "showVolume": false,
          "showActions": false
        },
        "home": {
          "sections": [
            "recent",
            "featured"
          ]
        },
        "settings": {
          "sections": [
            "accounts",
            "appearance",
            "about"
          ]
        }
      },
      "medium": {
        "nav": "rail"
      }
    }
  },
  "branding": {
    "appName": "Kitchen Sink",
    "shortName": "Kitchen",
    "tagline": "Every field, once",
    "wordmark": {
      "text": "Kitchen Sink",
      "fontFamily": "Cookie"
    },
    "titlebarTitle": "Kitchen Sink",
    "windowTitle": "Kitchen Sink",
    "aboutName": "Kitchen Sink",
    "notificationName": "Kitchen",
    "showHostAttribution": true
  },
  "assets": {
    "images": [
      {
        "path": "asset://images/icon.png",
        "kind": "icon",
        "role": "kitchen.icon"
      }
    ]
  },
  "ui": {
    "specVersion": 2,
    "slots": {
      "sidebar.footer": {
        "children": [
          {
            "type": "row",
            "gap": 8,
            "align": "center",
            "justify": "start",
            "children": [
              {
                "type": "text",
                "bind": "player.title",
                "size": "small",
                "weight": 600,
                "color": "@mutedForeground",
                "maxLines": 1,
                "align": "left",
                "overflow": "ellipsis",
                "letterSpacing": 0.2,
                "family": "Inter",
                "uppercase": false
              },
              {
                "type": "button",
                "label": "Lyrics",
                "icon": "lyrics",
                "variant": "ghost",
                "size": "small",
                "action": {
                  "type": "navigate",
                  "args": {
                    "target": "lyrics"
                  }
                }
              }
            ]
          }
        ]
      },
      "stage.center": {
        "refreshSeconds": 0,
        "children": [
          {
            "type": "animate",
            "kind": "rotate",
            "duration": 24000,
            "curve": "linear",
            "bind": "player.playing",
            "reverse": false,
            "children": [
              {
                "type": "stack",
                "align": "center",
                "fit": "expand",
                "children": [
                  {
                    "type": "image",
                    "src": "player.artwork",
                    "width": 360,
                    "height": 360,
                    "radius": 999,
                    "shape": "circle",
                    "fit": "cover",
                    "filter": "nearest",
                    "tile": false,
                    "opacity": 1
                  },
                  {
                    "type": "text",
                    "bind": "player.title",
                    "size": "xl",
                    "align": "center",
                    "maxLines": 2,
                    "overflow": "ellipsis"
                  }
                ]
              }
            ]
          }
        ]
      },
      "stage.below": {
        "children": [
          {
            "type": "row",
            "gap": 12,
            "justify": "center",
            "children": [
              {
                "type": "button",
                "icon": "previous",
                "size": "md",
                "action": {
                  "type": "previous"
                }
              },
              {
                "type": "button",
                "label": "Play",
                "icon": "play",
                "variant": "primary",
                "size": "md",
                "disabledWhen": "app.brightness",
                "actions": [
                  {
                    "type": "playPause"
                  },
                  {
                    "type": "toast",
                    "args": {
                      "message": "Toggled"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "icon": "next",
                "size": "md",
                "action": {
                  "type": "next"
                }
              }
            ]
          }
        ]
      },
      "player.progress": {
        "children": [
          {
            "type": "progress",
            "bind": "player.position",
            "maxBind": "player.duration",
            "width": 480,
            "height": 8,
            "hitHeight": 26,
            "radius": 4,
            "borderWidth": 1,
            "borderColor": "@border",
            "color": "@primary",
            "trackColor": "@muted",
            "thumbColor": "@primary",
            "thumbSize": 12,
            "interactive": true
          },
          {
            "type": "card",
            "padding": 8,
            "radius": 0,
            "background": "@card",
            "borderColor": "@border",
            "borderWidth": 2,
            "opacity": 1,
            "action": {
              "type": "openLyrics"
            },
            "children": [
              {
                "type": "divider",
                "orientation": "horizontal",
                "thickness": 2,
                "color": "@border"
              }
            ]
          }
        ]
      },
      "player.trailing": {
        "children": [
          {
            "type": "button",
            "label": "Now playing",
            "icon": "play",
            "action": {
              "type": "navigate",
              "args": {
                "target": "screen:now-playing"
              }
            }
          }
        ]
      }
    },
    "screens": {
      "now-playing": {
        "title": "Now playing",
        "showBack": true,
        "children": [
          {
            "type": "image",
            "bind": "player.artwork",
            "width": 220,
            "height": 220,
            "radius": 12,
            "shape": "circle",
            "fit": "cover",
            "filter": "nearest"
          },
          {
            "type": "text",
            "bind": "player.title",
            "size": "xl",
            "weight": "bold"
          },
          {
            "type": "text",
            "bind": "player.artist",
            "size": "md",
            "color": "@mutedForeground"
          },
          {
            "type": "row",
            "gap": 12,
            "children": [
              {
                "type": "button",
                "label": "Previous",
                "action": {
                  "type": "previous"
                }
              },
              {
                "type": "button",
                "label": "Play",
                "variant": "primary",
                "action": {
                  "type": "playPause"
                }
              },
              {
                "type": "button",
                "label": "Next",
                "action": {
                  "type": "next"
                }
              }
            ]
          }
        ]
      },
      "kitchen": {
        "title": "Kitchen",
        "children": [
          {
            "type": "padding",
            "all": 4,
            "horizontal": 8,
            "vertical": 4,
            "top": 2,
            "right": 2,
            "bottom": 2,
            "left": 2,
            "children": [
              {
                "type": "column",
                "gap": 8,
                "align": "stretch",
                "justify": "start",
                "children": [
                  {
                    "type": "wrap",
                    "gap": 8,
                    "runGap": 4,
                    "align": "start",
                    "justify": "start",
                    "children": [
                      {
                        "type": "text",
                        "text": "Static text",
                        "size": "2xl",
                        "uppercase": true
                      },
                      {
                        "type": "icon",
                        "icon": "play",
                        "size": 20,
                        "color": "@primary"
                      },
                      {
                        "type": "icon",
                        "icon": "asset://images/icon.png",
                        "size": 20
                      },
                      {
                        "type": "gap",
                        "size": 8
                      },
                      {
                        "type": "spacer",
                        "flex": 1
                      }
                    ]
                  },
                  {
                    "type": "align",
                    "align": "bottomRight",
                    "widthFactor": 1,
                    "heightFactor": 1,
                    "children": [
                      {
                        "type": "stack",
                        "align": "center",
                        "fit": "loose",
                        "children": [
                          {
                            "type": "card",
                            "padding": 12,
                            "radius": 8,
                            "background": "@card",
                            "borderColor": "@border",
                            "borderWidth": 1,
                            "opacity": 0.9,
                            "children": [
                              {
                                "type": "conditional",
                                "bind": "player.playing",
                                "equals": true,
                                "invert": false,
                                "children": [
                                  {
                                    "type": "text",
                                    "text": "Playing"
                                  },
                                  {
                                    "type": "text",
                                    "text": "Paused"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "expanded",
                    "flex": 1,
                    "children": [
                      {
                        "type": "scroll",
                        "direction": "vertical",
                        "padding": 4,
                        "children": [
                          {
                            "type": "template",
                            "name": "trackRow",
                            "args": {
                              "title": "Static",
                              "artist": "Static"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "templates": {
      "trackRow": {
        "params": [
          "title",
          "artist"
        ],
        "children": [
          {
            "type": "column",
            "gap": 2,
            "children": [
              {
                "type": "text",
                "bind": "player.title"
              },
              {
                "type": "text",
                "bind": "player.artist",
                "size": "small"
              }
            ]
          }
        ]
      }
    }
  },
  "ext": {
    "note": "Free-form data the host ignores. A theme may carry anything here."
  }
}
