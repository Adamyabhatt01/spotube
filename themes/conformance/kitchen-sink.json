  "layout": {
    "chrome": "inset",
    "nav": "labels",
    "progress": "inline",
    "navItems": [
      "home",
      "radio",
      "stats",
      "search"
    ],
    "navbarItems": [
      "home",
      "search",
      "radio",
      "library",
      "stats"
    ],
    "libraryItems": [
      "playlists",
      "artists",
      "albums",
      "local_library"
    ],
    "player": {
      "dock": "full",
      "showTrackDetails": true,
      "showActions": true,
      "showVolume": true,
      "showLyrics": true,
      "showProgress": true
    },
    "home": {
      "sections": [
        "recent",
        "featured",
        "new_releases",
        "browse"
      ]
    },
    "settings": {
      "sections": [
        "accounts",
        "language_region",
        "appearance",
        "sidebar",
        "playback",
        "downloads",
        "desktop",
        "developers",
        "about"
      ]
    },
    "titlebar": {
      "height": 40.0,
      "padding": 12.0,
      "showBack": true
    },
    "splash": {
      "text": "Kitchen Sink"
    },
    "enforce": [
      "playerDock"
    ],
    "responsive": {
      "compact": {
        "nav": "rail",
        "navItems": [
          "home",
          "radio",
          "stats"
        ],
        "player": {
          "showVolume": false,
          "showActions": false
        },
        "home": {
          "sections": [
            "recent",
            "featured"
          ]
        },
        "settings": {
          "sections": [
            "accounts",
            "appearance",
            "about"
          ]
        }
      },
      "medium": {
        "nav": "rail"
      }
    }
  },
  "branding": {
    "appName": "Kitchen Sink",
    "shortName": "Kitchen",
    "tagline": "Every field, once",
    "wordmark": {
      "text": "Kitchen Sink",
      "fontFamily": "Cookie"
    },
    "titlebarTitle": "Kitchen Sink",
    "windowTitle": "Kitchen Sink",
    "aboutName": "Kitchen Sink",
    "notificationName": "Kitchen",
    "showHostAttribution": true
  },
  "assets": {
    "images": []
  },
  "ui": {
    "specVersion": 1,
    "slots": {
      "sidebar.footer": {
        "children": [
          {
            "type": "row",
            "gap": 8,
            "children": [
              {
                "type": "text",
                "bind": "player.title",
                "maxLines": 1
              },
              {
                "type": "button",
                "label": "Lyrics",
                "icon": "lyrics",
                "action": {
                  "type": "navigate",
                  "args": {
                    "target": "lyrics"
                  }
                }
              }
            ]
          }
        ]
      },
      "player.trailing": {
        "children": [
          {
            "type": "button",
            "label": "Now playing",
            "icon": "play",
            "action": {
              "type": "navigate",
              "args": {
                "target": "screen:now-playing"
              }
            }
          }
        ]
      }
    },
    "screens": {
      "now-playing": {
        "title": "Now playing",
        "showBack": true,
        "children": [
          {
            "type": "image",
            "src": "albumArt",
            "width": 220,
            "height": 220,
            "radius": 12
          },
          {
            "type": "text",
            "bind": "player.title",
            "size": "xl"
          },
          {
            "type": "text",
            "bind": "player.artist",
            "size": "md"
          },
          {
            "type": "row",
            "gap": 12,
            "children": [
              {
                "type": "button",
                "label": "Previous",
                "action": {
                  "type": "previous"
                }
              },
              {
                "type": "button",
                "label": "Play",
                "variant": "primary",
                "action": {
                  "type": "playPause"
                }
              },
              {
                "type": "button",
                "label": "Next",
                "action": {
                  "type": "next"
                }
              }
            ]
          }
        ]
      }
    },
    "templates": {
      "trackRow": {
        "params": [
          "title",
          "artist"
        ],
        "children": [
          {
            "type": "column",
            "gap": 2,
            "children": [
              {
                "type": "text",
                "bind": "player.title"
              },
              {
                "type": "text",
                "bind": "player.artist",
                "size": "small"
              }
            ]
          }
        ]
      }
    }
  },
  "ext": {
    "note": "Free-form data the host ignores. A theme may carry anything here."
  }
}
