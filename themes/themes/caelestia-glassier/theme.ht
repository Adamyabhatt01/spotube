class CaelestiaThemeApi {
  fun getTheme() {
    return {
      'light': {
        'background': '#fafafa',
        'foreground': '#09090b',
        'card': '#ffffff',
        'cardForeground': '#09090b',
        'primary': '#18181b',
        'primaryForeground': '#fafafa',
        'secondary': '#f4f4f5',
        'secondaryForeground': '#18181b',
        'muted': '#f4f4f5',
        'mutedForeground': '#71717a',
        'accent': '#f4f4f5',
        'accentForeground': '#18181b',
        'destructive': '#ef4444',
        'destructiveForeground': '#fafafa',
        'border': '#e4e4e7',
        'input': '#e4e4e7',
        'ring': '#18181b'
      },
      'dark': {
        'background': '#0e0e0e',
        'foreground': '#e5e5e5',
        'card': '#1a1a1a',
        'cardForeground': '#e5e5e5',
        'primary': '#c6c6c6',
        'primaryForeground': '#404040',
        'secondary': '#9e9e9e',
        'secondaryForeground': '#202020',
        'muted': '#1a1a1a',
        'mutedForeground': '#ababab',
        'accent': '#ededed',
        'accentForeground': '#58585d',
        'destructive': '#d98883',
        'destructiveForeground': '#400e0e',
        'border': '#757575',
        'input': '#484848',
        'ring': '#c6c6c6'
      },
      'surfaces': {'opacity': 0.55, 'blur': 36.0},
      'background': {
        'source': 'shell',
        'opacity': 0.45,
        'blur': 50.0,
        'overlay': '#66FFFFFF',
        // Real window transparency opt-in: with the host setting on, the
        // compositor shows through and this painted backdrop/veil is
        // skipped (they would cover the desktop again). `false` would veto
        // even with the setting on; omitting the key defers to the setting.
        'transparent': true
      },
      'radius': {'small': 8.0, 'medium': 14.0, 'large': 20.0, 'pill': 999.0},
      'density': 1.0,
      'dynamic': {'source': 'shell', 'algorithm': 'material'}
    };
  }
}

class CaelestiaTheme {
  var theme = CaelestiaThemeApi();
}
