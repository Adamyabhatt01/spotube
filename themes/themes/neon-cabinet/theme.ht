                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'breadcrumb',
                                    'items': [
                                      {'label': 'CABINET', 'action': {'type': 'navigate', 'args': {'target': 'home'}}},
                                      {'label': 'HIGH SCORES', 'action': {'type': 'openPage', 'args': {'id': 'highscore'}}},
                                      {'label': 'AUDIO DECK', 'action': {'type': 'openPage', 'args': {'id': 'audio'}}},
