      // -------------------------------------------------------------- layout
      // The theme owns the sidebar, the aside and the shell itself: a marquee
      // rail above the page and a coin rail below it, which is a shape the
      // host never ships. `enforce` is gone — v4 reads intent from presence.
      'layout': {
        'chrome': 'flat',
        'nav': 'labels',
        'progress': 'inline',
        'sidebar': 'theme',
        'sidebarWidth': 248.0,
        'aside': 'theme',
        'asideWidth': 324.0,
        'navItems': ['home', 'search', 'radio', 'stats', 'screen:credits'],
        'navbarItems': ['home', 'search', 'library', 'stats'],
        'libraryItems': ['playlists', 'artists', 'albums', 'stations', 'local_library'],
        'player': {
          'dock': 'full',
          'showTrackDetails': true,
          'showActions': true,
          'showVolume': true,
          'showLyrics': true,
          'showProgress': true,
        },
        'home': {'sections': ['recent', 'featured', 'new_releases', 'browse']},
        'settings': {'sections': ['accounts', 'appearance', 'playback', 'about']},
        'titlebar': {'height': 36.0, 'padding': 12.0, 'showBack': true},
        'splash': {'logo': 'asset://images/coin.png', 'text': 'NEON CABINET'},

        // Two places a playlist may be pinned: the sidebar column the host
        // keeps, and this theme's own coin rail.
        'pinTargets': [
          {'id': 'sidebar', 'label': 'SIDEBAR'},
          {'id': 'deck', 'label': 'COIN RAIL'},
        ],

        'shell': {
          'type': 'column',
          'children': [
            {'region': 'titlebar', 'height': 36.0, 'safeArea': ['top']},
            {
              'type': 'row',
              'flex': 1,
              'children': [
                {
                  'region': 'sidebar',
                  'slot': 'sidebar.content',
                  'width': 248.0,
                  'minWidth': 180.0,
                  'maxWidth': 420.0,
                  'collapsible': true,
                  'collapsedSize': 76.0,
                  'resizable': {
                    'edges': ['end'],
                    'storageKey': 'cabinet.sidebar',
                    'min': 180.0,
                    'max': 420.0,
                  },
                  'label': 'Control panel',
                  'focusOrder': 1,
                },
                {
                  'type': 'column',
                  'flex': 1,
                  'children': [
                    {
                      'region': 'custom',
                      'id': 'deck.top',
                      'slot': 'deck.top',
                      'label': 'Marquee',
                      'height': 44.0,
                      'overflow': 'clip',
                    },
                    {'region': 'content', 'flex': 1, 'overflow': 'scroll'},
                    {
                      'region': 'custom',
                      'id': 'deck.bottom',
                      'slot': 'deck.bottom',
                      'label': 'Coin rail',
                      'height': 52.0,
                      'resizable': {
                        'edges': ['top'],
                        'storageKey': 'cabinet.deck',
                        'min': 44.0,
                        'max': 160.0,
                      },
                    },
                    {'region': 'player', 'height': 96.0},
                  ],
                },
                {
                  'region': 'aside',
                  'slot': 'aside.content',
                  'width': 324.0,
                  'minWidth': 240.0,
                  'maxWidth': 480.0,
                  'hiddenWhen': '!app.asideOpen',
                  'collapsible': true,
                  'collapsedSize': 0.0,
                  'resizable': {
                    'edges': ['start'],
                    'storageKey': 'cabinet.aside',
                    'min': 240.0,
                    'max': 480.0,
                  },
                  'label': 'Turntable',
                  'zIndex': 2,
                },
              ],
            },
          ],
        },

        'responsive': {
          // A cabinet on a small screen is a screen and a transport: the rails
          // and the turntable go, the bottom bar arrives.
          'compact': {
            'sidebar': 'host',
            'aside': 'none',
            'nav': 'labels',
            'player': {'showVolume': false, 'showLyrics': false},
            'shell': {
              'type': 'column',
              'children': [
                {'region': 'titlebar', 'height': 34.0, 'safeArea': ['top']},
                {'region': 'content', 'flex': 1, 'overflow': 'scroll'},
                {'region': 'player', 'height': 84.0},
                {'region': 'navbar', 'height': 58.0, 'safeArea': ['bottom']},
              ],
            },
          },
          'medium': {
            'aside': 'none',
          },
        },
      },

      // Routed destinations the host adds to its own sections. The host owns
      // the back stack and the nav entry; the theme owns `page.<id>`.
      'pages': [
        {'id': 'wave', 'title': 'WAVE ROOM', 'icon': 'queue', 'parent': 'sidebar', 'showBack': true},
        {'id': 'highscore', 'title': 'HIGH SCORES', 'icon': 'stats', 'parent': 'library', 'showBack': true},
        {'id': 'audio', 'title': 'AUDIO DECK', 'icon': 'settings', 'parent': 'settings', 'showBack': true},
      ],

      'branding': {
        'appName': 'NEON CABINET',
        'shortName': 'CABINET',
        'tagline': 'Insert coin, play music',
        'wordmark': {'text': 'NEON CABINET', 'fontFamily': 'Silkscreen'},
        'logo': 'asset://images/coin.png',
        'titlebarTitle': 'NEON CABINET',
        'windowTitle': 'NEON CABINET',
        'aboutName': 'Neon Cabinet',
        'notificationName': 'Cabinet',
        'showHostAttribution': true,
      },

      'assets': {
        'fonts': [
          {'path': 'asset://fonts/VT323-Regular.ttf', 'kind': 'font', 'role': 'text.body.regular'},
          {'path': 'asset://fonts/Silkscreen-Regular.ttf', 'kind': 'font', 'role': 'text.label'},
          {'path': 'asset://fonts/Silkscreen-Bold.ttf', 'kind': 'font', 'role': 'text.brand'},
        ],
        'images': [
          {'path': 'asset://images/coin.png', 'kind': 'image', 'role': 'branding.logo'},
          {'path': 'asset://images/scanlines.png', 'kind': 'image', 'role': 'texture.scanlines'},
          {'path': 'asset://images/grid.png', 'kind': 'image', 'role': 'texture.grid'},
        ],
        'other': [
          {'path': 'asset://fonts/OFL-VT323.txt', 'kind': 'other', 'role': 'license'},
          {'path': 'asset://fonts/OFL-Silkscreen.txt', 'kind': 'other', 'role': 'license'},
        ],
      },

      // ------------------------------------------------------------------ ui
      'ui': {
        'specVersion': 2,
        'pages': [
          {'id': 'wave', 'title': 'WAVE ROOM', 'icon': 'queue', 'parent': 'sidebar', 'showBack': true},
          {'id': 'highscore', 'title': 'HIGH SCORES', 'icon': 'stats', 'parent': 'library', 'showBack': true},
          {'id': 'audio', 'title': 'AUDIO DECK', 'icon': 'settings', 'parent': 'settings', 'showBack': true},
        ],
        'slots': {
          // ------------------------------------------------- sidebar: the panel
          // The theme owns the sidebar body, so it draws the nav too. Collapsed
          // is a real second design: the host narrows the box to its rail width
          // instead of hiding it, and `app.sidebarCollapsed` says which to draw.
          'sidebar.header': {
            'children': [
              {
                'type': 'row',
                'gap': 10,
                'align': 'center',
                'children': [
                  {
                    'type': 'image',
                    'src': 'asset://images/coin.png',
                    'width': 28,
                    'height': 28,
                    'filter': 'nearest',
                    'radius': 0,
                  },
                  {
                    'type': 'column',
                    'gap': 0,
                    'children': [
                      {
                        'type': 'text',
                        'text': 'NEON CABINET',
                        'size': 'xs',
                        'family': 'Silkscreen',
                        'color': '@primary',
                        'letterSpacing': 1.2,
                      },
                      {
                        'type': 'text',
                        'bind': 'user.name',
                        'size': 'sm',
                        'color': '@mutedForeground',
                        'maxLines': 1,
                        'overflow': 'ellipsis',
                      },
                    ],
                  },
                ],
              },
            ],
          },

          'sidebar.nav.before': {
            'children': [
              {
                'type': 'text',
                'text': 'SELECT A DECK',
                'size': 'xs',
                'family': 'Silkscreen',
                'color': '@mutedForeground',
                'letterSpacing': 1.2,
              },
            ],
          },

          'sidebar.content': {
            'children': [
              {
                'type': 'padding',
                'all': 12,
                'children': [
                  {
                    'type': 'column',
                    'gap': 10,
                    'children': [
                      {
                        'type': 'conditional',
                        'bind': 'app.sidebarCollapsed',
                        'equals': false,
                        'children': [
                          {
                            'type': 'column',
                            'gap': 10,
                            'children': [
                              {
                                'type': 'text',
                                'bind': 'app.greeting',
                                'size': 'xl',
                                'color': '@foreground',
                                'maxLines': 1,
                                'overflow': 'ellipsis',
                              },
                              {
                                'type': 'hostWidget',
                                'id': 'search.field',
                                'props': {
                                  'placeholder': 'SEARCH THE CABINET',
                                  'scope': 'rail',
                                },
                              },
                              {
                                'type': 'column',
                                'gap': 2,
                                'children': [
                                  {
                                    'type': 'button',
                                    'label': 'HOME',
                                    'icon': 'home',
                                    'variant': 'ghost',
                                    'action': {
                                      'type': 'navigate',
                                      'args': {'target': 'home'},
                                    },
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'SEARCH',
                                    'icon': 'search',
                                    'variant': 'ghost',
                                    'action': {
                                      'type': 'navigate',
                                      'args': {'target': 'search'},
                                    },
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'RADIO',
                                    'icon': 'radio',
                                    'variant': 'ghost',
                                    'action': {
                                      'type': 'navigate',
                                      'args': {'target': 'radio'},
                                    },
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'HIGH SCORES',
                                    'icon': 'stats',
                                    'variant': 'ghost',
                                    'action': {
                                      'type': 'openPage',
                                      'args': {'id': 'highscore'},
                                    },
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'WAVE ROOM',
                                    'icon': 'queue',
                                    'variant': 'ghost',
                                    'action': {
                                      'type': 'openPage',
                                      'args': {'id': 'wave'},
                                    },
                                  },
                                ],
                              },
                              {'type': 'divider', 'color': '@border', 'thickness': 2},
                              {
                                'type': 'text',
                                'text': 'HERO SHELVES',
                                'size': 'xs',
                                'family': 'Silkscreen',
                                'color': '@mutedForeground',
                                'letterSpacing': 1.2,
                              },
                              {
                                'type': 'hostWidget',
                                'id': 'library.playlists',
                                'props': {
                                  'compact': true,
                                  'showCreate': false,
                                  'filter': 'recent',
                                  'limit': 8,
                                  'direction': 'vertical',
                                },
                              },
                              {
                                'type': 'list',
                                'bind': 'library.pins',
                                'gap': 4,
                                'limit': 6,
                                'filter': {
                                  'bind': 'search.rail.query',
                                  'fields': ['title', 'name'],
                                },
                                'children': [
                                  {
                                    'type': 'row',
                                    'gap': 8,
                                    'align': 'center',
                                    'children': [
                                      {
                                        'type': 'image',
                                        'src': 'item.artwork',
                                        'width': 26,
                                        'height': 26,
                                        'radius': 0,
                                        'filter': 'nearest',
                                      },
                                      {
                                        'type': 'text',
                                        'bind': 'item.title',
                                        'size': 'sm',
                                        'maxLines': 1,
                                        'overflow': 'ellipsis',
                                      },
                                      {
                                        'type': 'button',
                                        'icon': 'close',
                                        'variant': 'ghost',
                                        'size': 'small',
                                        'action': {
                                          'type': 'unpinItem',
                                          'args': {'target': 'sidebar'},
                                        },
                                      },
                                    ],
                                  },
                                ],
                              },
                              {
                                'type': 'row',
                                'gap': 6,
                                'children': [
                                  {
                                    'type': 'button',
                                    'label': 'NEW LIST',
                                    'icon': 'plus',
                                    'variant': 'outline',
                                    'size': 'small',
                                    'action': {'type': 'createPlaylist'},
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'REFRESH',
                                    'variant': 'ghost',
                                    'size': 'small',
                                    'action': {
                                      'type': 'refresh',
                                      'args': {'scope': 'library'},
                                    },
                                  },
                                ],
                              },
                            ],
                          },
                          {
                            'type': 'column',
                            'gap': 4,
                            'align': 'center',
                            'children': [
                              {
                                'type': 'button',
                                'icon': 'home',
                                'variant': 'ghost',
                                'action': {
                                  'type': 'navigate',
                                  'args': {'target': 'home'},
                                },
                              },
                              {
                                'type': 'button',
                                'icon': 'search',
                                'variant': 'ghost',
                                'action': {
                                  'type': 'navigate',
                                  'args': {'target': 'search'},
                                },
                              },
                              {
                                'type': 'button',
                                'icon': 'stats',
                                'variant': 'ghost',
                                'action': {
                                  'type': 'openPage',
                                  'args': {'id': 'highscore'},
                                },
                              },
                              {
                                'type': 'button',
                                'icon': 'back',
                                'variant': 'ghost',
                                'action': {'type': 'toggleSidebar'},
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // The library group is the theme's own: a lazy list of playlists with
          // a delete that only appears on the row the pointer is over.
          'sidebar.library': {
            'children': [
              {
                'type': 'column',
                'gap': 6,
                'children': [
                  {
                    'type': 'row',
                    'gap': 6,
                    'align': 'center',
                    'children': [
                      {
                        'type': 'text',
                        'text': 'MY LISTS',
                        'size': 'xs',
                        'family': 'Silkscreen',
                        'color': '@mutedForeground',
                        'letterSpacing': 1.2,
                      },
                      {'type': 'spacer', 'flex': 1},
                      {
                        'type': 'badge',
                        'text': 'COIN OP',
                        'variant': 'outline',
                      },
                    ],
                  },
                  {
                    'type': 'virtualList',
                    'bind': 'library.playlists',
                    'itemTemplate': 'playlistRow',
                    'itemExtent': 36,
                    'overscan': 4,
                    'limit': 60,
                    'filter': {
                      'bind': 'search.rail.query',
                      'fields': ['title', 'name'],
                    },
                  },
                ],
              },
            ],
          },

          'sidebar.footer': {
            'children': [
              {
                'type': 'column',
                'gap': 6,
                'children': [
                  {
                    'type': 'row',
                    'gap': 6,
                    'align': 'center',
                    'children': [
                      {
                        'type': 'text',
                        'text': 'CREDIT 01',
                        'size': 'xs',
                        'family': 'Silkscreen',
                        'color': '@accentForeground',
                      },
                      {'type': 'spacer', 'flex': 1},
                      {
                        'type': 'text',
                        'bind': 'clock.now',
                        'size': 'sm',
                        'color': '@mutedForeground',
                      },
                    ],
                  },
                  {
                    'type': 'row',
                    'gap': 6,
                    'children': [
                      {
                        'type': 'button',
                        'icon': 'settings',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'openSettings'},
                      },
                      {
                        'type': 'button',
                        'label': 'CRT',
                        'variant': 'outline',
                        'size': 'small',
                        'action': {
                          'type': 'toggleSetting',
                          'args': {'key': 'crt'},
                        },
                      },
                      {
                        'type': 'button',
                        'icon': 'queue',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'openQueue'},
                      },
                    ],
                  },
                  {
                    'type': 'text',
                    'bind': 'theme.version',
                    'size': 'xs',
                    'color': '@mutedForeground',
                  },
                ],
              },
            ],
          },

          // --------------------------------------------- custom shell regions
          // The marquee: what is on the turntable, scrolling, with a light that
          // only burns while the transport runs.
          'deck.top': {
            'children': [
              {
                'type': 'stack',
                'align': 'center',
                'fit': 'expand',
                'children': [
                  {
                    'type': 'image',
                    'src': 'asset://images/grid.png',
                    'tile': true,
                    'opacity': 0.55,
                    'fit': 'none',
                  },
                  {
                    'type': 'row',
                    'gap': 12,
                    'align': 'center',
                    'children': [
                      {
                        'type': 'padding',
                        'horizontal': 12,
                        'children': [
                          {
                            'type': 'text',
                            'text': 'MARQUEE',
                            'size': 'xs',
                            'family': 'Silkscreen',
                            'color': '@secondary',
                            'letterSpacing': 1.4,
                          },
                        ],
                      },
                      {
                        'type': 'expanded',
                        'flex': 1,
                        'children': [
                          {
                            'type': 'animate',
                            'kind': 'float',
                            'duration': 5200,
                            'curve': 'easeInOutCubic',
                            'bind': 'player.playing',
                            'children': [
                              {
                                'type': 'row',
                                'gap': 8,
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'text',
                                    'bind': 'player.title',
                                    'size': 'md',
                                    'color': '@foreground',
                                    'maxLines': 1,
                                    'overflow': 'ellipsis',
                                  },
                                  {
                                    'type': 'text',
                                    'text': '—',
                                    'size': 'md',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'player.artist',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                    'maxLines': 1,
                                    'overflow': 'ellipsis',
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'conditional',
                        'bind': 'player.playing',
                        'equals': true,
                        'children': [
                          {
                            'type': 'animate',
                            'kind': 'pulse',
                            'duration': 620,
                            'curve': 'linear',
                            'children': [
                              {'type': 'badge', 'text': 'ON AIR', 'variant': 'primary'},
                            ],
                          },
                          {'type': 'badge', 'text': 'STANDBY', 'variant': 'outline'},
                        ],
                      },
                      {
                        'type': 'padding',
                        'right': 12,
                        'children': [
                          {
                            'type': 'text',
                            'bind': 'queue.count',
                            'size': 'sm',
                            'color': '@mutedForeground',
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // The coin rail: pinned playlists laid sideways, plus the three
          // surfaces a player actually needs at thumb distance.
          'deck.bottom': {
            'children': [
              {
                'type': 'row',
                'gap': 10,
                'align': 'center',
                'children': [
                  {
                    'type': 'padding',
                    'horizontal': 12,
                    'children': [
                      {
                        'type': 'image',
                        'src': 'asset://images/coin.png',
                        'width': 22,
                        'height': 22,
                        'filter': 'nearest',
                      },
                    ],
                  },
                  {
                    'type': 'expanded',
                    'flex': 3,
                    'children': [
                      {
                        'type': 'hostWidget',
                        'id': 'library.pins',
                        'props': {
                          'compact': true,
                          'target': 'deck',
                          'direction': 'horizontal',
                        },
                      },
                    ],
                  },
                  {'type': 'divider', 'orientation': 'vertical', 'color': '@border'},
                  {
                    'type': 'chip',
                    'label': 'SHUFFLE',
                    'selectedBind': 'player.shuffled',
                    'action': {
                      'type': 'setShuffle',
                      'args': {'value': '$value'},
                    },
                  },
                  {
                    'type': 'button',
                    'label': 'LYRICS',
                    'icon': 'lyrics',
                    'variant': 'outline',
                    'size': 'small',
                    'action': {'type': 'openLyrics'},
                  },
                  {
                    'type': 'button',
                    'label': 'DOWNLOADS',
                    'icon': 'download',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'openDownloads'},
                  },
                  {
                    'type': 'button',
                    'label': 'ASIDE',
                    'icon': 'play',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'toggleAside'},
                  },
                  {
                    'type': 'padding',
                    'right': 12,
                    'children': [
                      {
                        'type': 'text',
                        'bind': 'app.version',
                        'size': 'xs',
                        'color': '@mutedForeground',
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // -------------------------------------------------- the HUD overlay
          // Deliberately corner-hugged. `app.overlay` is a Positioned.fill above
          // the shell, and image/box nodes hit-test opaque — a full-bleed
          // scanline layer here would eat every click in the app. So the HUD is
          // two small clusters and empty space between them.
          'app.overlay': {
            'children': [
              {
                'type': 'column',
                'children': [
                  {
                    'type': 'row',
                    'children': [
                      {'type': 'spacer', 'flex': 1},
                      {
                        'type': 'padding',
                        'all': 44,
                        'children': [
                          {
                            'type': 'conditional',
                            'bind': 'app.asideOpen',
                            'equals': true,
                            'children': [
                              {'type': 'badge', 'text': 'TURNTABLE OPEN', 'variant': 'secondary'},
                              {'type': 'badge', 'text': 'CABINET HUD', 'variant': 'outline'},
                            ],
                          },
                        ],
                      },
                    ],
                  },
                  {'type': 'expanded', 'flex': 1},
                  {
                    'type': 'row',
                    'align': 'end',
                    'children': [
                      {'type': 'spacer', 'flex': 1},
                      {
                        'type': 'padding',
                        'all': 12,
                        'children': [
                          {
                            'type': 'column',
                            'gap': 2,
                            'align': 'end',
                            'children': [
                              {
                                'type': 'text',
                                'text': 'INSERT COIN',
                                'size': 'xs',
                                'family': 'Silkscreen',
                                'color': '@primary',
                              },
                              {
                                'type': 'text',
                                'bind': 'player.speed',
                                'size': 'xs',
                                'color': '@mutedForeground',
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          // ---------------------------------------------------- the player bar
          'player.leading': {
            'children': [
              {
                'type': 'row',
                'gap': 12,
                'align': 'center',
                'children': [
                  {
                    'type': 'stack',
                    'align': 'center',
                    'children': [
                      {
                        'type': 'image',
                        'src': 'player.artwork',
                        'width': 56,
                        'height': 56,
                        'radius': 0,
                        'filter': 'nearest',
                      },
                      {
                        'type': 'image',
                        'src': 'asset://images/scanlines.png',
                        'tile': true,
                        'width': 56,
                        'height': 56,
                        'opacity': 0.45,
                        'fit': 'none',
                      },
                    ],
                  },
                  {
                    'type': 'column',
                    'gap': 2,
                    'children': [
                      {
                        'type': 'text',
                        'bind': 'player.title',
                        'size': 'lg',
                        'maxLines': 1,
                        'overflow': 'ellipsis',
                      },
                      {
                        'type': 'row',
                        'gap': 6,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'bind': 'player.artist',
                            'size': 'sm',
                            'color': '@mutedForeground',
                            'maxLines': 1,
                            'overflow': 'ellipsis',
                          },
                          {
                            'type': 'conditional',
                            'bind': 'player.playing',
                            'equals': true,
                            'children': [
                              {'type': 'spinner', 'size': 14, 'color': '@primary'},
                              {
                                'type': 'text',
                                'bind': 'player.album',
                                'size': 'xs',
                                'color': '@mutedForeground',
                                'maxLines': 1,
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          'player.controls': {
            'children': [
              {
                'type': 'row',
                'gap': 8,
                'align': 'center',
                'justify': 'center',
                'children': [
                  {
                    'type': 'chip',
                    'label': 'SHUF',
                    'selectedBind': 'player.shuffled',
                    'action': {'type': 'setShuffle'},
                  },
                  {
                    'type': 'button',
                    'icon': 'previous',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'previous'},
                  },
                  {
                    'type': 'conditional',
                    'bind': 'player.playing',
                    'equals': true,
                    'children': [
                      {
                        'type': 'button',
                        'icon': 'pause',
                        'label': 'HOLD',
                        'variant': 'primary',
                        'size': 'small',
                        'action': {'type': 'playPause'},
                      },
                      {
                        'type': 'button',
                        'icon': 'play',
                        'label': 'PLAY',
                        'variant': 'primary',
                        'size': 'small',
                        'action': {'type': 'playPause'},
                      },
                    ],
                  },
                  {
                    'type': 'button',
                    'icon': 'next',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'next'},
                  },
                  {
                    'type': 'chip',
                    'label': 'REPEAT',
                    'selectedBind': 'player.loop',
                    'action': {'type': 'setLoopMode'},
                  },
                ],
              },
            ],
          },

          'player.trailing': {
            'children': [
              {
                'type': 'row',
                'gap': 10,
                'align': 'center',
                'children': [
                  {
                    'type': 'icon',
                    'icon': 'volume',
                    'size': 18,
                    'color': '@mutedForeground',
                  },
                  {
                    'type': 'slider',
                    'bind': 'player.volume',
                    'min': 0,
                    'max': 1,
                    'step': 0.05,
                    'showValue': false,
                    'action': {
                      'type': 'setVolume',
                      'args': {'volume': '$value'},
                    },
                  },
                  {
                    'type': 'button',
                    'icon': 'like',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'like'},
                  },
                  {
                    'type': 'menu',
                    'trigger': 'DECK',
                    'placement': 'topEnd',
                    'items': [
                      {
                        'label': 'AUDIO DECK',
                        'icon': 'settings',
                        'action': {'type': 'openPage', 'args': {'id': 'audio'}},
                      },
                      {
                        'label': 'WAVE ROOM',
                        'icon': 'queue',
                        'action': {'type': 'openPage', 'args': {'id': 'wave'}},
                      },
                      {
                        'label': 'COPY THEME LINE',
                        'action': {
                          'type': 'copy',
                          'args': {'text': 'NEON CABINET — a Spotube v4 theme'},
                        },
                      },
                      {
                        'label': 'TURN OFF CRT BANDS',
                        'action': {
                          'type': 'toggleSetting',
                          'args': {'key': 'crt'},
                        },
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // A wavy seek bar is the one ribbon the host draws: it breathes with
          // the playhead and stays draggable.
          'player.progress': {
            'children': [
              {
                'type': 'progress',
                'bind': 'player.position',
                'maxBind': 'player.duration',
                'style': 'wavy',
                'height': 6,
                'hitHeight': 20,
                'radius': 0,
                'borderWidth': 0,
                'color': '@primary',
                'trackColor': '@muted',
                'thumbColor': '@secondary',
                'interactive': true,
              },
            ],
          },

          // ------------------------------------------------------- the turntable
          'aside.content': {
            'children': [
              {
                'type': 'padding',
                'all': 14,
                'children': [
                  {
                    'type': 'column',
                    'gap': 12,
                    'children': [
                      {
                        'type': 'row',
                        'gap': 8,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'text': 'NOW SPINNING',
                            'size': 'xs',
                            'family': 'Silkscreen',
                            'color': '@secondary',
                            'letterSpacing': 1.4,
                          },
                          {'type': 'spacer', 'flex': 1},
                          {'type': 'badge', 'text': '33⅓', 'variant': 'outline'},
                        ],
                      },
                      {
                        'type': 'stack',
                        'align': 'center',
                        'children': [
                          {
                            'type': 'animate',
                            'kind': 'rotate',
                            'duration': 24000,
                            'curve': 'linear',
                            'bind': 'player.playing',
                            'children': [
                              {
                                'type': 'image',
                                'src': 'player.artwork',
                                'width': 240,
                                'height': 240,
                                'shape': 'circle',
                                'filter': 'nearest',
                              },
                            ],
                          },
                          // The CRT band, and the one setting that can veto it.
                          {
                            'type': 'conditional',
                            'bind': 'setting.crt',
                            'equals': false,
                            'children': [
                              {
                                'type': 'image',
                                'src': 'asset://images/scanlines.png',
                                'tile': true,
                                'width': 240,
                                'height': 240,
                                'opacity': 0.5,
                                'fit': 'none',
                              },
                              {'type': 'gap', 'size': 0},
                            ],
                          },
                          {
                            'type': 'card',
                            'width': 16,
                            'height': 16,
                            'radius': 999,
                            'background': '@primary',
                            'borderWidth': 2,
                            'borderColor': '@card',
                          },
                        ],
                      },
                      {
                        'type': 'column',
                        'gap': 2,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'bind': 'player.title',
                            'size': 'xl',
                            'align': 'center',
                            'maxLines': 2,
                            'overflow': 'ellipsis',
                          },
                          {
                            'type': 'text',
                            'bind': 'player.artist',
                            'size': 'sm',
                            'color': '@mutedForeground',
                            'align': 'center',
                            'maxLines': 1,
                          },
                        ],
                      },
                      // The cover's own colours, sampled by the host and painted
                      // as a strip: this is what makes two albums look different.
                      {
                        'type': 'row',
                        'gap': 4,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'card',
                            'width': 30,
                            'height': 12,
                            'radius': 0,
                            'background': '@palette.dominant',
                          },
                          {
                            'type': 'card',
                            'width': 30,
                            'height': 12,
                            'radius': 0,
                            'background': '@palette.vibrant',
                          },
                          {
                            'type': 'card',
                            'width': 30,
                            'height': 12,
                            'radius': 0,
                            'background': '@palette.muted',
                          },
                          {
                            'type': 'card',
                            'width': 30,
                            'height': 12,
                            'radius': 0,
                            'background': '@palette.lightMuted',
                          },
                          {
                            'type': 'text',
                            'text': 'FROM THE SLEEVE',
                            'size': 'xs',
                            'color': '@mutedForeground',
                          },
                        ],
                      },
                      {
                        'type': 'progress',
                        'bind': 'player.position',
                        'maxBind': 'player.duration',
                        'style': 'wavy',
                        'height': 8,
                        'hitHeight': 22,
                        'radius': 0,
                        'color': '@secondary',
                        'trackColor': '@muted',
                        'thumbColor': '@primary',
                        'interactive': true,
                      },
                      {
                        'type': 'row',
                        'justify': 'spaceBetween',
                        'children': [
                          {
                            'type': 'text',
                            'bind': 'player.position',
                            'size': 'sm',
                            'color': '@mutedForeground',
                          },
                          {
                            'type': 'text',
                            'bind': 'player.duration',
                            'size': 'sm',
                            'color': '@mutedForeground',
                          },
                        ],
                      },
                      {
                        'type': 'tabs',
                        'items': [
                          {'id': 'up', 'label': 'UP NEXT', 'icon': 'queue'},
                          {'id': 'rig', 'label': 'RIG', 'icon': 'settings'},
                          {'id': 'now', 'label': 'SLEEVE', 'icon': 'lyrics'},
                        ],
                        'panels': [
                          [
                            {
                              'type': 'virtualList',
                              'bind': 'queue.tracks',
                              'itemTemplate': 'queueRow',
                              'itemExtent': 44,
                              'overscan': 3,
                              'limit': 120,
                            },
                          ],
                          [
                            {
                              'type': 'column',
                              'gap': 8,
                              'children': [
                                {
                                  'type': 'hostWidget',
                                  'id': 'audio.equalizer',
                                  'props': {'bands': 6},
                                },
                                {
                                  'type': 'slider',
                                  'bind': 'audio.bass',
                                  'min': -12,
                                  'max': 12,
                                  'step': 1,
                                  'label': 'BASS',
                                  'showValue': true,
                                  'action': {
                                    'type': 'setBass',
                                    'args': {'value': '$value'},
                                  },
                                },
                                {
                                  'type': 'slider',
                                  'bind': 'audio.treble',
                                  'min': -12,
                                  'max': 12,
                                  'step': 1,
                                  'label': 'TREBLE',
                                  'showValue': true,
                                  'action': {
                                    'type': 'setTreble',
                                    'args': {'value': '$value'},
                                  },
                                },
                                {
                                  'type': 'row',
                                  'gap': 8,
                                  'align': 'center',
                                  'children': [
                                    {
                                      'type': 'switch',
                                      'label': 'NORMALIZE',
                                      'bind': 'audio.normalization',
                                      'action': {
                                        'type': 'setNormalization',
                                        'args': {'value': '$value'},
                                      },
                                    },
                                    {
                                      'type': 'button',
                                      'label': 'SLEEP',
                                      'variant': 'outline',
                                      'size': 'small',
                                      'action': {
                                        'type': 'setSleepTimer',
                                        'args': {'value': 30},
                                      },
                                    },
                                  ],
                                },
                              ],
                            },
                          ],
                          [
                            {
                              'type': 'column',
                              'gap': 6,
                              'children': [
                                {
                                  'type': 'image',
                                  'src': 'player.artwork',
                                  'width': 260,
                                  'height': 260,
                                  'radius': 0,
                                  'fit': 'contain',
                                },
                                {
                                  'type': 'text',
                                  'bind': 'player.album',
                                  'size': 'sm',
                                  'color': '@mutedForeground',
                                  'maxLines': 2,
