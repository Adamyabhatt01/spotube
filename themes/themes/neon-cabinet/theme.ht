// NEON CABINET — an arcade-CRT shell for Spotube, built on the v4 contract.
//
// The idea: the app is a coin-op cabinet. A near-black violet frame, hot
// magenta and cyan neon, square-cornered panels with a two-tone pixel bevel,
// a Silkscreen wordmark over VT323 body text, CRT scanline bands across the
// artwork, and a marquee rail above the page plus a coin rail below it.
//
// It exercises the v4 contract rather than decorating it: the theme owns the
// sidebar, the aside, three routed pages, two custom shell regions, the home,
// search, queue, downloads, stats, collection, artist and local-library
// bodies, the player bar, context-menu rows, render points for search and
// context menus, its own settings page, and a corner HUD overlay.
//
// One constraint shapes the overlay design: `image` and filled boxes hit-test
// opaque (RenderImage.hitTestSelf is true), so a full-bleed scanline layer in
// `app.overlay` would swallow every click in the app. The CRT bands therefore
// sit only over artwork and non-interactive bands, never over the page.
class NeonCabinetThemeApi {
  fun getTheme() {
    return {
      'specVersion': 4,
      'uiKit': 'shadcn',
      'capabilities': [
        'library.read',
        'library.write',
        'player.control',
        'audio.effects',
        'ui.pages',
        'ui.hostWidgets',
        'settings.write',
        'clipboard.write',
      ],

      // ------------------------------------------------------------ palettes
      // The light scheme is the cabinet in daylight: hot pink on lilac paper.
      'light': {
        'background': '#fbf2ff',
        'foreground': '#2b0940',
        'card': '#ffffff',
        'cardForeground': '#2b0940',
        'primary': '#d6008c',
        'primaryForeground': '#fff0fa',
        'secondary': '#0090b5',
        'secondaryForeground': '#eaffff',
        'muted': '#f0e2f8',
        'mutedForeground': '#6b4d80',
        'accent': '#ffdff2',
        'accentForeground': '#8a0057',
        'destructive': '#d1134a',
        'destructiveForeground': '#ffffff',
        'border': '#dcc4ee',
        'input': '#f3e6fa',
        'ring': '#d6008c',
        'popover': '#ffffff',
        'popoverForeground': '#2b0940',
        'sidebar': '#f4e9fb',
        'sidebarForeground': '#5c3b73',
        'sidebarPrimary': '#d6008c',
        'sidebarPrimaryForeground': '#fff0fa',
        'sidebarAccent': '#ffdff2',
        'sidebarAccentForeground': '#8a0057',
        'sidebarBorder': '#dcc4ee',
        'sidebarRing': '#0090b5',
        'success': '#0e9f6e',
        'successForeground': '#ffffff',
        'warning': '#b26a00',
        'warningForeground': '#ffffff',
        'info': '#0090b5',
        'infoForeground': '#ffffff',
        'chart1': '#d6008c',
        'chart2': '#0090b5',
        'chart3': '#c98a00',
        'chart4': '#0e9f6e',
        'chart5': '#7b2ff7',
        'chart6': '#e35205',
      },

      // The dark scheme is the one the cabinet is drawn for.
      'dark': {
        'background': '#08010f',
        'foreground': '#f4e9ff',
        'card': '#140622',
        'cardForeground': '#f4e9ff',
        'primary': '#ff2fb9',
        'primaryForeground': '#0b0110',
        'secondary': '#22e0ff',
        'secondaryForeground': '#04121a',
        'muted': '#1a0b26',
        'mutedForeground': '#a88ec2',
        'accent': '#2b0f42',
        'accentForeground': '#ffe97a',
        'destructive': '#ff3859',
        'destructiveForeground': '#ffffff',
        'border': '#3d1a5c',
        'input': '#2b0f42',
        'ring': '#22e0ff',
        'popover': '#160724',
        'popoverForeground': '#f4e9ff',
        'sidebar': '#0b0216',
        'sidebarForeground': '#c2a9dc',
        'sidebarPrimary': '#ff2fb9',
        'sidebarPrimaryForeground': '#0b0110',
        'sidebarAccent': '#2b0f42',
        'sidebarAccentForeground': '#ffe97a',
        'sidebarBorder': '#3d1a5c',
        'sidebarRing': '#22e0ff',
        'success': '#3dff9a',
        'successForeground': '#04150c',
        'warning': '#ffb020',
        'warningForeground': '#1a0f00',
        'info': '#22e0ff',
        'infoForeground': '#04121a',
        'chart1': '#ff2fb9',
        'chart2': '#22e0ff',
        'chart3': '#ffe97a',
        'chart4': '#3dff9a',
        'chart5': '#a855ff',
        'chart6': '#ff5c2b',
      },

      // ------------------------------------------------------------ surfaces
      // A cabinet is solid: slight translucency on the panels, no blur soup.
      'surfaces': {
        'opacity': 0.94,
        'blur': 4.0,
      },

      // The artwork bleeds through the page at a low dose, tiled never.
      'background': {
        'source': 'albumArt',
        'opacity': 0.16,
        'blur': 60.0,
        'scale': 2.0,
        'tile': false,
        'transparent': false,
      },

      // Square corners everywhere except the pills that mean "select".
      'radius': {
        'small': 0.0,
        'medium': 2.0,
        'large': 4.0,
        'pill': 999.0,
      },

      'density': 1.0,

      // -------------------------------------------------------------- tokens
      'tokens': {
        'cardWidth': 168.0,
        'cardHeight': 224.0,
        'artistCardWidth': 168.0,
        'artistCardHeight': 232.0,
        'gutter': 16.0,
        'fontFamily': 'VT323',
      },

      // ------------------------------------------------------------ typography
      // VT323 is a terminal face: small x-height, so the ladder runs larger
      // than a UI font would. Silkscreen is reserved for the wordmark and the
      // uppercase labels — pixel type at 32px is a wall, at 12px it is a legend.
      'typography': {
        'fonts': [
          {'family': 'VT323', 'asset': 'asset://fonts/VT323-Regular.ttf', 'weight': 400.0, 'style': 'normal'},
          {'family': 'Silkscreen', 'asset': 'asset://fonts/Silkscreen-Regular.ttf', 'weight': 400.0, 'style': 'normal'},
          {'family': 'Silkscreen', 'asset': 'asset://fonts/Silkscreen-Bold.ttf', 'weight': 700.0, 'style': 'normal'},
        ],
        'family': 'VT323',
        'monoFamily': 'VT323',
        'brandFamily': 'Silkscreen',
        'styles': {
          'h1': {'fontSize': 34.0, 'fontWeight': 400.0, 'height': 1.05, 'letterSpacing': -0.4, 'fontFamily': 'VT323'},
          'h2': {'fontSize': 27.0, 'fontWeight': 400.0, 'height': 1.1, 'fontFamily': 'VT323'},
          'h3': {'fontSize': 22.0, 'fontWeight': 400.0, 'height': 1.15, 'fontFamily': 'VT323'},
          'h4': {'fontSize': 19.0, 'fontWeight': 400.0, 'height': 1.2, 'fontFamily': 'VT323'},
          'p': {'fontSize': 17.0, 'fontWeight': 400.0, 'height': 1.45, 'fontFamily': 'VT323'},
          'lead': {'fontSize': 19.0, 'fontWeight': 400.0, 'height': 1.4, 'fontFamily': 'VT323'},
          'large': {'fontSize': 21.0, 'fontWeight': 400.0, 'height': 1.3, 'fontFamily': 'VT323'},
          'small': {'fontSize': 16.0, 'fontWeight': 400.0, 'height': 1.35, 'fontFamily': 'VT323'},
          'muted': {'fontSize': 16.0, 'fontWeight': 400.0, 'height': 1.35, 'color': '@mutedForeground', 'fontFamily': 'VT323'},
          'xSmall': {'fontSize': 14.0, 'fontWeight': 400.0, 'height': 1.3, 'fontFamily': 'VT323'},
          'xLarge': {'fontSize': 28.0, 'fontWeight': 400.0, 'height': 1.2, 'fontFamily': 'VT323'},
          'x2Large': {'fontSize': 40.0, 'fontWeight': 400.0, 'height': 1.1, 'fontFamily': 'VT323'},
          'x3Large': {'fontSize': 56.0, 'fontWeight': 400.0, 'height': 1.0, 'fontFamily': 'VT323'},
          'brand': {'fontSize': 15.0, 'fontWeight': 700.0, 'height': 1.2, 'letterSpacing': 2.4, 'color': '@primary', 'fontFamily': 'Silkscreen'},
          'label': {'fontSize': 11.0, 'fontWeight': 700.0, 'height': 1.2, 'letterSpacing': 1.8, 'color': '@mutedForeground', 'fontFamily': 'Silkscreen'},
        },
      },

      'spacing': {
        'xs': 4.0,
        'sm': 8.0,
        'md': 12.0,
        'lg': 16.0,
        'xl': 24.0,
        'xxl': 32.0,
        'page': 20.0,
        'section': 28.0,
        'cardGap': 16.0,
        'pageHorizontal': 20.0,
        'custom': {'railHeight': 44.0, 'coinHeight': 52.0},
      },

      // Arcade timing: fast, overshooting, no slow fades.
      'motion': {
        'fast': 90.0,
        'normal': 160.0,
        'slow': 260.0,
        'pageTransition': 180.0,
        'sheet': 220.0,
        'easing': 'easeOutCubic',
        'custom': {'blink': 620.0},
      },

      'scale': {
        'size': 1.0,
        'text': 1.0,
        'radius': 1.0,
        'icon': 1.0,
        'spacing': 1.0,
      },

      'icons': {
        'sm': 14.0,
        'md': 18.0,
        'lg': 24.0,
        'xl': 28.0,
      },

      // ---------------------------------------------------------- components
      // Every group that draws chrome gets the pixel bevel: a two-tone edge
      // derived from borderColor, which is how a flat panel reads as a cabinet.
      'components': {
        'buttons': {
          'primary': {
            'background': '@primary',
            'foreground': '@primaryForeground',
            'borderColor': '@primary',
            'borderWidth': 2.0,
            'borderStyle': 'pixel',
            'radius': 2.0,
            'padding': 14.0,
            'height': 36.0,
            'gap': 8.0,
            'fontFamily': 'VT323',
            'fontSize': 17.0,
            'fontWeight': 400.0,
            'letterSpacing': 0.6,
            'iconSize': 18.0,
          },
          'secondary': {
            'background': '@secondary',
            'foreground': '@secondaryForeground',
            'borderColor': '@secondary',
            'borderWidth': 2.0,
            'borderStyle': 'pixel',
            'radius': 2.0,
            'padding': 14.0,
            'height': 36.0,
            'gap': 8.0,
            'fontFamily': 'VT323',
            'fontSize': 17.0,
            'iconSize': 18.0,
          },
          'outline': {
            'background': '#00000000',
            'foreground': '@foreground',
            'borderColor': '@border',
            'borderWidth': 2.0,
            'borderStyle': 'pixel',
            'radius': 2.0,
            'padding': 14.0,
