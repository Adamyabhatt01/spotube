                              },
                            ],
                          },
                          {
                            'type': 'button',
                            'label': 'WAVE ROOM',
                            'icon': 'queue',
                            'variant': 'outline',
                            'size': 'small',
                            'action': {
                              'type': 'openPage',
                              'args': {'id': 'wave'},
                            },
                          },
