                      {
                        'type': 'virtualList',
                        'bind': 'library.folders',
                        'itemTemplate': 'folderRow',
                        'itemExtent': 42,
                        'overscan': 3,
                        'limit': 200,
                        'filter': {
                          'bind': 'search.rail.query',
