                            'family': 'Silkscreen',
                            'color': '@primary',
                            'letterSpacing': 1.4,
                          },
                          {
                            'type': 'text',
                            'bind': 'downloads.count',
                            'size': 'sm',
                            'color': '@mutedForeground',
                          },
                          {'type': 'spacer', 'flex': 1},
                          {
                            'type': 'button',
                            'label': 'RE-READ',
                            'variant': 'ghost',
                            'size': 'small',
                            'action': {
                              'type': 'refresh',
                              'args': {'scope': 'library'},
                            },
                          },
                        ],
                      },
                      {
                        'type': 'table',
                        'bind': 'downloads.items',
                        'columns': [
                          {'key': 'title', 'label': 'TRACK', 'width': 240},
                          {'key': 'artist', 'label': 'ARTIST', 'width': 160},
                          {'key': 'status', 'label': 'STATUS', 'width': 120},
                          {'key': 'size', 'label': 'SIZE', 'align': 'end', 'width': 100},
                        ],
                        'rowTemplate': 'downloadRow',
                        'stickyHeader': true,
                        'sortable': true,
                      },
                      {
                        'type': 'conditional',
                        'bind': 'downloads.count',
                        'equals': 0,
                        'children': [
                          {
                            'type': 'row',
                            'gap': 8,
                            'align': 'center',
                            'children': [
                              {'type': 'skeleton', 'width': 200, 'height': 14, 'radius': 0, 'count': 4},
                              {
                                'type': 'text',
                                'text': 'EMPTY VAULT',
                                'size': 'xs',
                                'family': 'Silkscreen',
                                'color': '@mutedForeground',
                              },
                            ],
                          },
                          {'type': 'gap', 'size': 0},
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // ----------------------------------------------------------- the stats
          'stats.content': {
            'children': [
