                          {'type': 'card', 'width': 26, 'height': 12, 'radius': 0, 'background': '@chart2'},
                          {'type': 'card', 'width': 26, 'height': 12, 'radius': 0, 'background': '@chart3'},
                          {'type': 'card', 'width': 26, 'height': 12, 'radius': 0, 'background': '@chart4'},
                          {'type': 'card', 'width': 26, 'height': 12, 'radius': 0, 'background': '@chart5'},
