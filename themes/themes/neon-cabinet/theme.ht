                                  'type': 'button',
                                  'label': 'LYRICS',
                                  'icon': 'lyrics',
                                  'variant': 'outline',
                                  'size': 'small',
                                  'action': {'type': 'openLyrics'},
                                },
                              ],
                            },
                          ],
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          // ------------------------------------------------------------- home
          // `home.content` replaces the whole home body, including the host's
          // own search row — so the theme draws the top bar and the shelves.
          'home.content': {
            'children': [
              {
                'type': 'padding',
                'all': 20,
                'children': [
                  {
                    'type': 'column',
                    'gap': 20,
                    'children': [
                      {
                        'type': 'row',
                        'gap': 12,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'column',
                            'gap': 2,
                            'children': [
                              {
                                'type': 'text',
                                'bind': 'home.greeting',
                                'size': '2xl',
                                'color': '@foreground',
                              },
                              {
                                'type': 'text',
                                'text': 'PRESS START',
                                'size': 'xs',
                                'family': 'Silkscreen',
