                          {
                            'type': 'table',
                            'bind': 'home.recent',
                            'columns': [
                              {'key': 'title', 'label': 'TRACK', 'width': 260},
                              {'key': 'artist', 'label': 'ARTIST', 'width': 180},
                              {'key': 'album', 'label': 'SLEEVE', 'width': 180},
                              {'key': 'duration', 'label': 'TIME', 'align': 'end', 'width': 80},
