                            'type': 'column',
                            'gap': 6,
                            'children': [
                              {
                                'type': 'text',
                                'text': 'CABINET MODE',
                                'size': 'xl',
                                'family': 'Silkscreen',
                                'color': '@primaryForeground',
                                'letterSpacing': 1.8,
                              },
                              {
                                'type': 'row',
                                'gap': 10,
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'text',
                                    'bind': 'theme.name',
                                    'size': 'sm',
                                    'color': '@primaryForeground',
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'app.brightness',
                                    'size': 'sm',
                                    'color': '@primaryForeground',
                                  },
                                  {
                                    'type': 'button',
                                    'label': 'INSERT COIN',
                                    'variant': 'secondary',
                                    'size': 'small',
                                    'action': {
                                      'type': 'plugin',
                                      'args': {'id': 'coin'},
                                    },
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'column',
                        'gap': 8,
                        'children': [
                          {
                            'type': 'text',
                            'text': 'NEW RELEASES',
                            'size': 'xs',
                            'family': 'Silkscreen',
                            'color': '@mutedForeground',
                            'letterSpacing': 1.4,
                          },
                          {
                            'type': 'list',
                            'bind': 'home.newReleases',
                            'direction': 'horizontal',
                            'gap': 12,
                            'limit': 16,
                            'children': [
                              {
                                'type': 'template',
                                'name': 'coverCard',
                              },
                            ],
                          },
