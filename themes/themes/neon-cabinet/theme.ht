                                'type': 'text',
                                'text': 'IN THE ROTATION',
                                'size': 'xs',
                                'family': 'Silkscreen',
                                'color': '@mutedForeground',
                                'letterSpacing': 1.4,
                              },
                              {'type': 'spacer', 'flex': 1},
                              {
                                'type': 'button',
                                'label': 'PLAY ALL',
                                'icon': 'play',
                                'variant': 'primary',
                                'size': 'small',
                                'action': {'type': 'playCollection'},
