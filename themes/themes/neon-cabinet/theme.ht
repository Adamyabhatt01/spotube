          // ------------------------------------------------------- settings tail
          'settings.after': {
            'children': [
              {
                'type': 'card',
                'padding': 16,
                'radius': 2,
                'borderWidth': 2,
                'children': [
                  {
                    'type': 'column',
                    'gap': 10,
                    'children': [
                      {
                        'type': 'row',
                        'gap': 8,
                        'align': 'center',
                        'children': [
