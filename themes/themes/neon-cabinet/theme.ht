                          {'type': 'spacer', 'flex': 1},
                          {
                            'type': 'expanded',
                            'flex': 2,
                            'children': [
                              {
                                'type': 'hostWidget',
                                'id': 'search.field',
                                'props': {
                                  'placeholder': 'SEARCH THE VAULT',
                                  'scope': 'home',
