            'iconSize': 18.0,
          },
          'ghost': {
            'background': '#00000000',
            'foreground': '@mutedForeground',
            'borderWidth': 0.0,
            'radius': 2.0,
            'padding': 10.0,
            'gap': 6.0,
            'fontFamily': 'VT323',
            'fontSize': 16.0,
            'iconSize': 18.0,
          },
          'destructive': {
            'background': '@destructive',
            'foreground': '@destructiveForeground',
            'borderColor': '@destructive',
            'borderWidth': 2.0,
            'borderStyle': 'pixel',
            'radius': 2.0,
            'padding': 14.0,
            'height': 36.0,
            'fontFamily': 'VT323',
            'fontSize': 17.0,
            'iconSize': 18.0,
          },
          'link': {
            'background': '#00000000',
            'foreground': '@secondary',
            'borderWidth': 0.0,
            'radius': 0.0,
            'padding': 4.0,
            'fontFamily': 'VT323',
            'fontSize': 16.0,
          },
          'muted': {
