                      },
                      {
                        'type': 'text',
                        'text': 'The service panel lives here. Values persist per theme, so another cabinet can use the same key without collision.',
                        'size': 'sm',
                        'color': '@mutedForeground',
                      },
                      {
                        'type': 'hostWidget',
                        'id': 'theme.settings',
                        'props': {},
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // ------------------------------------------------------ routed pages
          // WAVE ROOM: the record, huge, with the whole rig underneath it.
          'page.wave': {
            'children': [
              {
                'type': 'scroll',
                'direction': 'vertical',
                'padding': 20,
                'children': [
                  {
                    'type': 'column',
                    'gap': 18,
                    'children': [
                      {
                        'type': 'stack',
                        'align': 'center',
                        'fit': 'expand',
                        'children': [
                          {
                            'type': 'box',
                            'gradient': {
                              'colors': ['@background', '@palette.darkMuted'],
                              'begin': 'center',
                              'end': 'bottomRight',
                            },
                            'radius': 2,
                            'height': 300,
                            'border': {'color': '@border', 'width': 2},
                            'children': [
                              {'type': 'gap', 'size': 0},
                            ],
                          },
                          {
                            'type': 'column',
                            'gap': 10,
                            'align': 'center',
                            'children': [
                              {
                                'type': 'animate',
                                'kind': 'rotate',
                                'duration': 16000,
                                'curve': 'linear',
                                'bind': 'player.playing',
                                'children': [
                                  {
                                    'type': 'image',
                                    'src': 'player.artwork',
                                    'width': 220,
                                    'height': 220,
                                    'shape': 'circle',
                                    'filter': 'nearest',
                                  },
                                ],
                              },
                              {
                                'type': 'text',
                                'bind': 'player.title',
                                'size': 'xl',
                                'color': '@foreground',
                                'maxLines': 1,
                                'overflow': 'ellipsis',
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'row',
                        'gap': 12,
                        'children': [
                          {
                            'type': 'expanded',
                            'flex': 1,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 6,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'LOW END',
                                    'size': 'xs',
                                    'family': 'Silkscreen',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'slider',
                                    'bind': 'audio.bass',
                                    'min': -12,
                                    'max': 12,
                                    'step': 1,
                                    'showValue': true,
                                    'action': {
                                      'type': 'setBass',
                                      'args': {'value': '$value'},
                                    },
                                  },
                                  {
                                    'type': 'slider',
                                    'bind': 'audio.crossfade',
                                    'min': 0,
                                    'max': 12,
                                    'step': 1,
                                    'label': 'CROSSFADE',
                                    'showValue': true,
                                    'action': {
                                      'type': 'setCrossfade',
                                      'args': {'value': '$value'},
                                    },
                                  },
                                ],
                              },
                            ],
                          },
                          {
                            'type': 'expanded',
                            'flex': 1,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 6,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'HIGH END',
                                    'size': 'xs',
                                    'family': 'Silkscreen',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'slider',
                                    'bind': 'audio.treble',
                                    'min': -12,
                                    'max': 12,
                                    'step': 1,
                                    'showValue': true,
                                    'action': {
                                      'type': 'setTreble',
                                      'args': {'value': '$value'},
                                    },
                                  },
                                  {
                                    'type': 'slider',
                                    'bind': 'audio.speed',
                                    'min': 0.5,
                                    'max': 2,
                                    'step': 0.05,
                                    'label': 'TEMPO',
                                    'showValue': true,
                                    'action': {
                                      'type': 'setSpeed',
                                      'args': {'value': '$value'},
                                    },
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'hostWidget',
                        'id': 'audio.equalizer',
                        'props': {'bands': 8},
                      },
                      {
                        'type': 'row',
                        'gap': 10,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'switch',
                            'label': 'LOUDNESS NORMALIZATION',
                            'bind': 'audio.normalization',
                            'action': {
                              'type': 'setNormalization',
                              'args': {'value': '$value'},
                            },
                          },
                          {
                            'type': 'checkbox',
                            'label': 'MUTE',
                            'bind': 'player.muted',
                            'action': {
                              'type': 'setMuted',
                              'args': {'value': '$value'},
                            },
                          },
                          {
                            'type': 'hostWidget',
                            'id': 'audio.sleepTimer',
                            'props': {},
                          },
                        ],
                      },
                      {
                        'type': 'column',
                        'gap': 6,
                        'children': [
                          {
                            'type': 'text',
                            'text': 'UP NEXT IN THE ROOM',
                            'size': 'xs',
                            'family': 'Silkscreen',
                            'color': '@secondary',
                            'letterSpacing': 1.4,
                          },
                          {
                            'type': 'list',
                            'bind': 'queue.next',
                            'gap': 2,
                            'limit': 6,
                            'align': 'stretch',
                            'children': [
                              {'type': 'template', 'name': 'queueRow'},
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // AUDIO DECK: the same rig as a settings child page, laid out as a
          // table of what the host currently reports.
          'page.audio': {
            'children': [
              {
                'type': 'padding',
                'all': 20,
                'children': [
                  {
                    'type': 'column',
                    'gap': 16,
                    'children': [
                      {
                        'type': 'row',
                        'gap': 10,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'text': 'AUDIO DECK',
                            'size': '2xl',
                            'family': 'Silkscreen',
                            'color': '@foreground',
                            'letterSpacing': 1.4,
                          },
                          {'type': 'spacer', 'flex': 1},
                          {
                            'type': 'text',
                            'bind': 'audio.sleepTimer',
                            'size': 'sm',
                            'color': '@mutedForeground',
                          },
                        ],
                      },
                      {
                        'type': 'grid',
                        'columns': 2,
                        'gap': 12,
                        'children': [
                          {
                            'type': 'card',
                            'padding': 14,
                            'radius': 2,
                            'borderWidth': 2,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 6,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'VOLUME / POSITION',
                                    'size': 'xs',
                                    'family': 'Silkscreen',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'slider',
                                    'bind': 'player.volume',
                                    'min': 0,
                                    'max': 1,
                                    'step': 0.05,
                                    'showValue': true,
                                    'action': {
                                      'type': 'setVolume',
                                      'args': {'volume': '$value'},
                                    },
                                  },
                                  {
                                    'type': 'progress',
                                    'bind': 'player.position',
                                    'maxBind': 'player.duration',
                                    'height': 8,
                                    'hitHeight': 22,
                                    'radius': 0,
                                    'color': '@primary',
                                    'trackColor': '@muted',
                                    'thumbColor': '@secondary',
                                    'interactive': true,
                                  },
                                ],
                              },
                            ],
                          },
                          {
                            'type': 'card',
                            'padding': 14,
                            'radius': 2,
                            'borderWidth': 2,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 6,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'TRANSPORT STATE',
                                    'size': 'xs',
                                    'family': 'Silkscreen',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'radioGroup',
                                    'bind': 'player.loop',
                                    'options': [
                                      {'value': 'off', 'label': 'NONE', 'icon': 'close'},
                                      {'value': 'all', 'label': 'ALL', 'icon': 'repeat'},
                                      {'value': 'one', 'label': 'ONE', 'icon': 'repeatOne'},
                                    ],
                                    'action': {
                                      'type': 'setLoopMode',
                                      'args': {'mode': '$value'},
                                    },
                                  },
                                  {
                                    'type': 'segmented',
                                    'bind': 'player.playing',
                                    'options': ['RUN', 'HOLD'],
                                    'action': {'type': 'playPause'},
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'table',
                        'bind': 'queue.tracks',
                        'columns': [
                          {'key': 'title', 'label': 'QUEUED', 'width': 300},
                          {'key': 'artist', 'label': 'ARTIST', 'width': 200},
                          {'key': 'duration', 'label': 'TIME', 'align': 'end', 'width': 90},
                        ],
                        'rowTemplate': 'trackRow',
                        'stickyHeader': true,
                        'sortable': true,
                      },
                      {
                        'type': 'button',
                        'label': 'RESET THE RIG',
                        'variant': 'destructive',
                        'size': 'small',
                        'action': {
                          'type': 'plugin',
                          'args': {'id': 'resetRig'},
                        },
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // HIGH SCORES: the ranked table with the ladder beside it.
          'page.highscore': {
            'children': [
              {
                'type': 'padding',
                'all': 20,
                'children': [
                  {
                    'type': 'column',
                    'gap': 14,
                    'children': [
                      {
                        'type': 'row',
                        'gap': 10,
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'text': 'HIGH SCORES',
                            'size': '2xl',
                            'family': 'Silkscreen',
                            'color': '@primary',
                            'letterSpacing': 1.6,
                          },
                          {'type': 'spacer', 'flex': 1},
                          {
                            'type': 'button',
                            'label': 'FULL REPORT',
                            'icon': 'stats',
                            'variant': 'outline',
                            'size': 'small',
                            'action': {
                              'type': 'navigate',
                              'args': {'target': 'stats'},
                            },
                          },
                        ],
                      },
                      {
                        'type': 'virtualList',
                        'bind': 'stats.topTracks',
                        'itemTemplate': 'rankRow',
                        'itemExtent': 52,
                        'overscan': 5,
                        'limit': 100,
                      },
                      {
                        'type': 'collapsible',
                        'title': 'SLEEVES THAT RANKED',
                        'openBind': 'search.hasQuery',
                        'children': [
                          {
                            'type': 'list',
                            'bind': 'stats.albums',
                            'direction': 'horizontal',
                            'gap': 10,
                            'limit': 12,
                            'children': [
                              {'type': 'template', 'name': 'coverCard'},
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          // @@SLOTS@@
        },
        'templates': {},
        'screens': {},
        'menus': {},
        'renderPoints': {},
      },
    }
  }
}

class NeonCabinetTheme {
  var theme = NeonCabinetThemeApi();
}
