                                  'type': 'text',
                                  'text': 'New releases',
                                  'size': 'xl',
                                  'weight': 800,
                                  'letterSpacing': -0.4,
                                },
                                {
                                  'type': 'button',
                                  'label': 'Show all',
                                  'variant': 'ghost',
                                  'size': 'small',
                                  'action': {
                                    'type': 'navigate',
