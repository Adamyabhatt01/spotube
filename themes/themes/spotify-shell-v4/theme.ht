                      },
                    ],
                  },
                ],
              },
              {'type': 'gap', 'size': 48},
            ],
          },
          // v4 page: rendered by the host inside the routed page shell.
          // The sliders are bound to host audio state; the actions clamp and
          // persist through the same path the equalizer settings use.
          'page.audio': {
            'children': [
              {
                'type': 'padding',
                'horizontal': 24,
                'top': 24,
                'bottom': 24,
                'children': [
                  {
                    'type': 'column',
                    'gap': 16,
                    'children': [
                      {
                        'type': 'text',
                        'text': 'Audio',
                        'size': '2xl',
                        'weight': 800,
                      },
                      {
                        'type': 'text',
                        'text': 'Tune the player. Changes apply immediately and survive a restart.',
                        'size': 'sm',
                        'color': '@mutedForeground',
                      },
                      {
                        'type': 'text',
                        'text': 'Playback',
                        'size': 'sm',
                        'weight': 700,
                        'color': '@mutedForeground',
                      },
                      {
                        'type': 'card',
                        'background': '@card',
                        'radius': 12,
                        'padding': 16,
                        'children': [
                          {
                            'type': 'column',
                            'gap': 16,
                            'children': [
                              {
                                'type': 'slider',
                                'bind': 'audio.speed',
                                'min': 0.5,
                                'max': 2.0,
                                'step': 0.25,
                                'label': 'Playback speed',
                                'showValue': true,
                                'action': {
                                  'type': 'setSpeed',
                                  'args': {'value': '$value'},
                                },
                              },
                              {
                                'type': 'slider',
                                'bind': 'player.volume',
                                'min': 0,
                                'max': 1,
                                'step': 0.05,
                                'label': 'Volume',
                                'showValue': true,
                                'action': {
                                  'type': 'setVolume',
                                  'args': {'volume': '$value'},
                                },
                              },
                              {
                                'type': 'switch',
                                'bind': 'player.muted',
                                'label': 'Mute',
                                'action': {
                                  'type': 'setMuted',
                                  'args': {'value': '$value'},
                                },
                              },
                              {
                                // `audio.sleepTimer` binds the remaining
                                // minutes (0 when off), so the thumb also
                                // counts down while a timer runs; committing
                                // sets an absolute length from now, and 0
                                // cancels.
                                'type': 'slider',
                                'bind': 'audio.sleepTimer',
                                'min': 0,
                                'max': 120,
                                'step': 15,
                                'label': 'Sleep timer (min)',
                                'showValue': true,
                                'action': {
                                  'type': 'setSleepTimer',
                                  'args': {'value': '$value'},
                                },
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'text',
                        'text': 'Effects',
                        'size': 'sm',
                        'weight': 700,
                        'color': '@mutedForeground',
                      },
                      {
                        'type': 'card',
                        'background': '@card',
                        'radius': 12,
                        'padding': 16,
                        'children': [
                          {
                            'type': 'column',
                            'gap': 16,
                            'children': [
                              {
                                'type': 'slider',
                                'bind': 'audio.bass',
                                'min': -12,
                                'max': 12,
                                'step': 1,
                                'label': 'Bass',
                                'showValue': true,
                                'action': {
                                  'type': 'setBass',
                                  'args': {'value': '$value'},
                                },
                              },
                              {
                                'type': 'slider',
                                'bind': 'audio.treble',
                                'min': -12,
                                'max': 12,
                                'step': 1,
                                'label': 'Treble',
                                'showValue': true,
                                'action': {
                                  'type': 'setTreble',
                                  'args': {'value': '$value'},
                                },
                              },
                              {
                                'type': 'switch',
                                'bind': 'audio.normalization',
                                'label': 'Audio normalization',
                                'action': {
                                  'type': 'setNormalization',
                                  'args': {'value': '$value'},
                                },
                              },
                              {
                                'type': 'slider',
                                'bind': 'audio.crossfade',
                                'min': 0,
                                'max': 15,
                                'step': 1,
                                'label': 'Crossfade (s)',
                                'showValue': true,
                                'action': {
                                  'type': 'setCrossfade',
                                  'args': {'value': '$value'},
                                },
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
          'radio.after_sections': {
            'children': [
              {
                'type': 'conditional',
                'bind': 'radio.active',
                'children': [
                  {
                    'type': 'padding',
                    'horizontal': 24,
                    'top': 16,
                    'bottom': 8,
                    'children': [
                      {
                        'type': 'card',
                        'background': '@card',
                        'radius': 12,
                        'padding': 16,
                        'children': [
                          {
                            'type': 'row',
                            'gap': 12,
                            'align': 'center',
                            'children': [
                              {
                                'type': 'icon',
                                'icon': 'radio',
                                'size': 20,
                                'color': '@primary',
                              },
                              {
                                'type': 'expanded',
                                'flex': 1,
                                'children': [
                                  {
                                    'type': 'column',
                                    'gap': 2,
                                    'children': [
                                      {
                                        'type': 'text',
                                        'bind': 'radio.station',
                                        'size': 'sm',
                                        'weight': 700,
                                        'maxLines': 1,
                                        'overflow': 'ellipsis',
                                      },
                                      {
                                        'type': 'text',
                                        'bind': 'radio.liveTitle',
                                        'size': 'xs',
                                        'color': '@mutedForeground',
                                        'maxLines': 1,
                                        'overflow': 'ellipsis',
                                      },
                                    ],
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },
        },
      },
    }
  }
}

class SpotifyTheme {
  var theme = SpotifyThemeApi();
}
