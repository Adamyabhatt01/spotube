// Spotify-shaped shell for Spotube.
//
// The layout, spacing, type scale and colour roles follow the Spotify desktop
// app: a black frame around a #121212 panel, a labelled sidebar, green pills,
// 180px cards on 20px gutters and a full-width player.
//
// It deliberately carries no Spotify logo. The brand marks are a plain green
// circle and the theme's own name; nothing here is a Spotify asset.
class SpotifyThemeApi {
  fun getTheme() {
    return {
      'specVersion': 4,
      'uiKit': 'shadcn',
      'capabilities': [
        'library.read',
        'player.control',
        'audio.effects',
        'ui.pages',
        'ui.hostWidgets',
      ],

      // ------------------------------------------------------------ palettes
      'light': {
        'background': '#ffffff',
        'foreground': '#000000',
        'card': '#f6f6f6',
        'cardForeground': '#000000',
        'primary': '#1ed760',
        'primaryForeground': '#000000',
        'secondary': '#f0f0f0',
        'secondaryForeground': '#000000',
        'muted': '#f6f6f6',
        'mutedForeground': '#6a6a6a',
        'accent': '#ededed',
        'accentForeground': '#000000',
        'destructive': '#e91429',
        'destructiveForeground': '#ffffff',
        'border': '#e5e5e5',
        'input': '#f0f0f0',
        'ring': '#1ed760',
        'popover': '#ffffff',
        'popoverForeground': '#000000',
        'sidebar': '#f6f6f6',
        'sidebarForeground': '#5c5c5c',
        'sidebarPrimary': '#000000',
        'sidebarPrimaryForeground': '#ffffff',
        'sidebarAccent': '#e9e9e9',
        'sidebarAccentForeground': '#000000',
        'sidebarBorder': '#e5e5e5',
        'sidebarRing': '#1ed760',
        'success': '#0f9d58',
        'successForeground': '#ffffff',
        'warning': '#b26a00',
        'warningForeground': '#ffffff',
        'info': '#0b57d0',
        'infoForeground': '#ffffff',
        'chart1': '#1ed760',
        'chart2': '#0b57d0',
        'chart3': '#e91429',
        'chart4': '#b26a00',
        'chart5': '#7c3aed',
        'chart6': '#0891b2',
      },

      'dark': {
        'background': '#121212',
        'foreground': '#ffffff',
        'card': '#181818',
        'cardForeground': '#ffffff',
        'primary': '#1ed760',
        'primaryForeground': '#000000',
        'secondary': '#1f1f1f',
        'secondaryForeground': '#ffffff',
        'muted': '#181818',
        'mutedForeground': '#a7a7a7',
        'accent': '#2a2a2a',
        'accentForeground': '#ffffff',
        'destructive': '#e91429',
        'destructiveForeground': '#ffffff',
        'border': '#292929',
        'input': '#292929',
        'ring': '#1ed760',
        'popover': '#282828',
        'popoverForeground': '#ffffff',
        'sidebar': '#000000',
        'sidebarForeground': '#b3b3b3',
        'sidebarPrimary': '#ffffff',
        'sidebarPrimaryForeground': '#000000',
        'sidebarAccent': '#1a1a1a',
        'sidebarAccentForeground': '#ffffff',
        'sidebarBorder': '#000000',
        'sidebarRing': '#1ed760',
        'success': '#1ed760',
        'successForeground': '#000000',
        'warning': '#ffa42b',
        'warningForeground': '#000000',
        'info': '#4cb3ff',
        'infoForeground': '#000000',
        'chart1': '#1ed760',
        'chart2': '#4cb3ff',
        'chart3': '#e91429',
        'chart4': '#ffa42b',
        'chart5': '#b49bff',
        'chart6': '#3ad5d5',
      },

      // Spotify is opaque: no glass, no blur, no wallpaper. `none` keeps the
      // scaffold on the theme's own background role even on a desktop shell
      // that could offer a wallpaper — a shell-sourced backdrop at opacity 0
      // would still turn the scaffold transparent and decode an image nothing
      // paints.
      'surfaces': {
        'opacity': 1.0,
        'blur': 0.0,
      },
      'background': {
        'source': 'none',
        'opacity': 0.0,
        'blur': 0.0,
        'transparent': false,
      },

      'radius': {
        'small': 4.0,
        'medium': 8.0,
        'large': 8.0,
        'pill': 999.0,
      },

      'density': 1.0,

      // -------------------------------------------------------------- tokens
      'tokens': {
        'cardWidth': 180.0,
        'cardHeight': 240.0,
        'artistCardWidth': 180.0,
        'artistCardHeight': 248.0,
        'gutter': 20.0,
        'fontFamily': 'Inter',
      },

      'typography': {
        // Inter is not a platform font: the four weights the type scale asks
        // for ship with the theme, under the family name every style uses.
        'fonts': [
          {'family': 'Inter', 'asset': 'asset://fonts/Inter-Regular.ttf', 'weight': 400.0, 'style': 'normal'},
          {'family': 'Inter', 'asset': 'asset://fonts/Inter-Medium.ttf', 'weight': 500.0, 'style': 'normal'},
          {'family': 'Inter', 'asset': 'asset://fonts/Inter-Bold.ttf', 'weight': 700.0, 'style': 'normal'},
          {'family': 'Inter', 'asset': 'asset://fonts/Inter-ExtraBold.ttf', 'weight': 800.0, 'style': 'normal'},
        ],
        'family': 'Inter',
        'monoFamily': 'Inter',
        'brandFamily': 'Inter',
        'styles': {
          'h1': {'fontSize': 32.0, 'fontWeight': 800.0, 'height': 1.1, 'letterSpacing': -1.0, 'fontFamily': 'Inter'},
          'h2': {'fontSize': 24.0, 'fontWeight': 800.0, 'height': 1.15, 'letterSpacing': -0.6, 'fontFamily': 'Inter'},
          'h3': {'fontSize': 20.0, 'fontWeight': 700.0, 'height': 1.2, 'letterSpacing': -0.4, 'fontFamily': 'Inter'},
          'h4': {'fontSize': 16.0, 'fontWeight': 700.0, 'height': 1.25, 'letterSpacing': -0.2, 'fontFamily': 'Inter'},
          'p': {'fontSize': 14.0, 'fontWeight': 400.0, 'height': 1.5, 'fontFamily': 'Inter'},
          'lead': {'fontSize': 16.0, 'fontWeight': 400.0, 'height': 1.5, 'fontFamily': 'Inter'},
          'large': {'fontSize': 18.0, 'fontWeight': 500.0, 'height': 1.4, 'fontFamily': 'Inter'},
          'small': {'fontSize': 14.0, 'fontWeight': 400.0, 'height': 1.4, 'fontFamily': 'Inter'},
          'muted': {'fontSize': 14.0, 'fontWeight': 400.0, 'height': 1.4, 'color': '@mutedForeground', 'fontFamily': 'Inter'},
          'xSmall': {'fontSize': 12.0, 'fontWeight': 400.0, 'height': 1.3, 'fontFamily': 'Inter'},
          'xLarge': {'fontSize': 20.0, 'fontWeight': 700.0, 'height': 1.3, 'fontFamily': 'Inter'},
          'x2Large': {'fontSize': 24.0, 'fontWeight': 800.0, 'height': 1.2, 'fontFamily': 'Inter'},
          'x3Large': {'fontSize': 32.0, 'fontWeight': 800.0, 'height': 1.1, 'fontFamily': 'Inter'},
          'brand': {'fontSize': 22.0, 'fontWeight': 800.0, 'height': 1.0, 'letterSpacing': -0.6, 'color': '@foreground', 'fontFamily': 'Inter'},
          'label': {'fontSize': 11.0, 'fontWeight': 700.0, 'height': 1.2, 'letterSpacing': 1.2, 'color': '@mutedForeground', 'fontFamily': 'Inter'},
        },
      },

      'spacing': {
        'xs': 4.0,
        'sm': 8.0,
        'md': 12.0,
        'lg': 16.0,
        'xl': 24.0,
        'xxl': 32.0,
        'page': 24.0,
        'section': 32.0,
        'cardGap': 20.0,
        'pageHorizontal': 24.0,
      },

      'motion': {
        'fast': 120.0,
        'normal': 200.0,
        'slow': 320.0,
        'pageTransition': 220.0,
        'sheet': 300.0,
        'easing': 'easeOutCubic',
      },

      'scale': {
        'size': 1.0,
        'text': 1.0,
        'radius': 1.0,
        'icon': 1.0,
        'spacing': 1.0,
      },

      // Spotify's own icon rhythm: compact 16px controls in rows, 24px in the
      // transport, 32px for page-level marks.
      'icons': {
        'sm': 16.0,
        'md': 20.0,
        'lg': 24.0,
        'xl': 32.0,
      },

      // ---------------------------------------------------------- components
      'components': {
        'buttons': {
          'primary': {
            'background': '@primary',
            'foreground': '@primaryForeground',
            'borderColor': '@primary',
            'borderWidth': 0.0,
            'radius': 999.0,
            'padding': 14.0,
            'gap': 8.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 700.0,
            'letterSpacing': 0.2,
            'iconSize': 18.0,
          },
          'secondary': {
            'background': '@secondary',
            'foreground': '@secondaryForeground',
            'borderColor': '@secondary',
            'borderWidth': 0.0,
            'radius': 999.0,
            'padding': 14.0,
            'gap': 8.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 700.0,
            'iconSize': 18.0,
          },
          'outline': {
            'background': '#00000000',
            'foreground': '@foreground',
            'borderColor': '#7c7c7c',
            'borderWidth': 1.0,
            'radius': 999.0,
            'padding': 14.0,
            'gap': 8.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 700.0,
            'iconSize': 18.0,
          },
          'ghost': {
            'background': '#00000000',
            'foreground': '@mutedForeground',
            'borderWidth': 0.0,
            'radius': 999.0,
            'padding': 8.0,
            'gap': 8.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 600.0,
            'iconSize': 18.0,
          },
          'destructive': {
            'background': '@destructive',
            'foreground': '@destructiveForeground',
            'borderColor': '@destructive',
            'borderWidth': 0.0,
            'radius': 999.0,
            'padding': 14.0,
            'gap': 8.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 700.0,
            'iconSize': 18.0,
          },
          'link': {
            'background': '#00000000',
            'foreground': '@mutedForeground',
            'borderWidth': 0.0,
            'radius': 0.0,
            'padding': 2.0,
            'fontFamily': 'Inter',
            'fontSize': 12.0,
            'fontWeight': 700.0,
          },
          'fixed': {
            'background': '@card',
            'foreground': '@foreground',
            'borderColor': '@border',
            'borderWidth': 0.0,
            'radius': 8.0,
            'padding': 14.0,
            'fontFamily': 'Inter',
            'fontSize': 14.0,
            'fontWeight': 700.0,
            'iconSize': 18.0,
          },
          'muted': {
            'background': '@muted',
            'foreground': '@mutedForeground',
            'borderColor': '@muted',
            'borderWidth': 0.0,
            'radius': 999.0,
            'padding': 12.0,
            'fontFamily': 'Inter',
            'fontSize': 13.0,
            'fontWeight': 600.0,
            'iconSize': 18.0,
          },
        },
        'card': {
          'radius': 8.0,
          'padding': 12.0,
          'background': '@card',
          'borderColor': '@border',
          'borderWidth': 0.0,
        },
        'player': {
          'background': '#000000',
          'borderColor': '#000000',
          'borderWidth': 0.0,
        },
        'input': {
          'radius': 999.0,
          'height': 40.0,
          'borderColor': '#00000000',
          'background': '@secondary',
        },
        'tabs': {'indicatorColor': '@primary', 'radius': 999.0},
        'nav': {'radius': 8.0, 'padding': 8.0},
        'tooltip': {'radius': 8.0, 'padding': 8.0, 'surfaceOpacity': 1.0},
        'badge': {'radius': 999.0, 'padding': 4.0, 'fontSize': 11.0},
        'select': {'radius': 8.0, 'height': 40.0},
        'switch': {'thumbColor': '@primary'},
        'slider': {'thumbColor': '@foreground', 'trackColor': '#4d4d4d'},
        'scrollbar': {'radius': 999.0},
        'avatar': {'radius': 999.0},
        'skeleton': {'radius': 8.0, 'surfaceOpacity': 1.0},
        'progress': {'radius': 999.0, 'background': '@primary'},
        'divider': {'borderColor': '@border'},
        'menu': {'radius': 8.0, 'padding': 6.0},
        'dropdown': {'radius': 8.0},
        'modal': {'radius': 8.0},
        'dialog': {'radius': 8.0, 'padding': 24.0},
        'sheet': {'radius': 8.0},
        'table': {'radius': 8.0},
        'checkbox': {'radius': 4.0},
        'radio': {'radius': 999.0},
        'toggle': {'radius': 999.0},
        'toggleGroup': {'radius': 999.0},
        'accordion': {'radius': 8.0},
        'alert': {'radius': 8.0, 'padding': 12.0},
        'breadcrumb': {'gap': 8.0},
        'carousel': {'radius': 8.0},
        'collapsible': {'radius': 8.0},
        'command': {'radius': 8.0, 'padding': 8.0},
        'contextMenu': {'radius': 8.0, 'padding': 6.0},
        'drawer': {'radius': 8.0},
        'hoverCard': {'radius': 8.0},
        'pagination': {'radius': 999.0},
        'popover': {'radius': 8.0},
        'resizable': {'radius': 8.0},
        'sidebar': {'radius': 8.0},
        'stepper': {'radius': 999.0},
        'toast': {'radius': 8.0},
        'tree': {'radius': 8.0},
      },

      // -------------------------------------------------------------- layout
      'layout': {
        'chrome': 'inset',
        'nav': 'labels',
        // The seek line belongs inside the centre transport block, the way
        // Spotify's player reads; a full-width line under the bar made the
        // footer twice as tall as the reference.
        'progress': 'inline',
        // Spotify's left panel is 280 wide; shadcn's default 200 is a rail
        // width and makes the library labels read as clipped.
        'sidebar': 'theme',
        'sidebarWidth': 280.0,
        'aside': 'theme',
        'asideWidth': 300.0,
        'player': {
          'dock': 'full',
          'showTrackDetails': true,
          // The theme draws the trailing row itself so likes, downloads,
          // queue and volume sit on one line instead of the host's stacked
          // actions-over-volume column.
          'showActions': false,
          'showVolume': false,
          'showLyrics': true,
          'showProgress': true,
        },
        'navItems': ['home', 'search'],
        'navbarItems': ['home', 'search', 'library'],
        'libraryItems': ['playlists', 'albums', 'artists', 'local_library'],
        'titlebar': {
          'height': 44.0,
          'padding': 16.0,
          'showBack': true,
        },
        'responsive': {
          'compact': {
            'nav': 'labels',
            'sidebarWidth': 220.0,
            'aside': 'none',
            'titlebar': {'height': 40.0},
            'player': {'showVolume': false, 'showLyrics': false},
          },
          'medium': {'sidebarWidth': 240.0, 'aside': 'none'},
        },
      },

      // v4 theme pages: a routed destination under a host section. The host
      // adds the entry and owns the back stack; the theme owns `page.audio`.
      'pages': [
        {
          'id': 'audio',
          'title': 'Audio',
          'icon': 'equalizer',
          'parent': 'settings',
          'showBack': true,
        },
      ],

      'branding': {
        'appName': 'Spotube',
        'shortName': 'Spotube',
        'wordmark': {'text': 'Music', 'fontFamily': 'Inter'},
        'aboutName': 'Spotube',
        'notificationName': 'Spotube',
        'windowTitle': 'Spotube',
      },

      'assets': {
        'fonts': [
          {'path': 'asset://fonts/Inter-Regular.ttf', 'kind': 'font', 'role': 'text.body.regular'},
          {'path': 'asset://fonts/Inter-Medium.ttf', 'kind': 'font', 'role': 'text.body.medium'},
          {'path': 'asset://fonts/Inter-Bold.ttf', 'kind': 'font', 'role': 'text.body.bold'},
          {'path': 'asset://fonts/Inter-ExtraBold.ttf', 'kind': 'font', 'role': 'text.heading'},
        ],
        'other': [
          {'path': 'asset://fonts/OFL-Inter.txt', 'kind': 'other', 'role': 'license'},
        ],
      },

      // ------------------------------------------------------------------ ui
      'ui': {
        'specVersion': 2,
        'pages': [
          {
            'id': 'audio',
            'title': 'Audio',
            'icon': 'equalizer',
            'parent': 'settings',
            'showBack': true,
          },
        ],
        'slots': {
          // Spotify's left rail is its own panel: black against the #121212
          // page, with Home/Search over a library that keeps its own header,
          // filter pills and profile row. Owning `sidebar.content` is the only
          // way to get that composition; the host keeps the width, divider and
          // player clearance around it.
          'sidebar.content': {
            'children': [
              {
                'type': 'conditional',
                'bind': 'app.sidebarCollapsed',
                'children': [
                  {
                    'type': 'box',
                    'background': '@sidebar',
                    'padding': 8,
                    'animate': 200,
                    'children': [
                      {
                        'type': 'column',
                        'gap': 8,
                        'align': 'stretch',
                        'children': [
                          {
                            'type': 'card',
                            'width': 40,
                            'height': 40,
                            'radius': 999,
                            'padding': 0,
                            'background': '@primary',
                            'borderWidth': 0,
                            'children': [
                              {
                                'type': 'align',
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'icon',
                                    'icon': 'music',
                                    'size': 20,
                                    'color': '@primaryForeground',
                                  },
                                ],
                              },
                            ],
                          },
                          {
                            'type': 'expanded',
                            'flex': 1,
                            'children': [
                              {
                                'type': 'scroll',
                                'children': [
                                  {
                                    'type': 'conditional',
                                    'bind': 'user.name',
                                    'children': [
                                      {
                                        'type': 'hostWidget',
                                        'id': 'library.playlists',
                                        'props': {
                                          'compact': true,
                                          'showSearch': true,
                                          'showCreate': false,
                                          'limit': 40,
                                          'showTitle': false,
                                          'showPin': false,
                                          'showQueue': false,
                                          'showPlay': false,
                                          'coverPlays': true,
                                          'filter': 'recent',
                                          'showSubtitle': false,
                                          'density': 'compact',
                                          'coverSize': 48,
                                          'coverRadius': 4,
                                          'showDividers': false,
                                        },
                                      },
                                    ],
                                  },
                                ],
                              },
                            ],
                          },
                          {
                            'type': 'button',
                            'icon': 'chevronRight',
                            'variant': 'ghost',
                            'size': 'small',
                            'action': {'type': 'toggleSidebar'},
                          },
                        ],
                      },
                    ],
                  },
                  {
                    'type': 'box',
                    'background': '@sidebar',
                    'padding': 8,
                    'animate': 200,
                    'children': [
                      {'type': 'gap', 'size': 8},
                      // Spotify keeps the library on its own rounded #121212
                      // surface. The black rail around it is the window frame; the
                      // 8px gutter is what makes the panel read as a separate card
                      // instead of one slab with the navigation on top.
                      {
                        'type': 'expanded',
                        'flex': 1,
                        'children': [
                          {
                            'type': 'box',
                            'background': '@background',
                            'radius': 8,
                            'padding': 8,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 8,
                                'children': [
                                  {
                                    'type': 'row',
                                    'gap': 8,
                                    'align': 'center',
                                    'children': [
                                      {
                                        'type': 'icon',
                                        'icon': 'library',
                                        'size': 20,
                                        'color': '@mutedForeground',
                                      },
                                      {
                                        'type': 'text',
                                        'text': 'Your Library',
                                        'size': 'md',
                                        'weight': 700,
                                      },
                                      {'type': 'spacer', 'flex': 1},
                                      {
                                        'type': 'button',
                                        'icon': 'plus',
                                        'variant': 'ghost',
                                        'size': 'small',
                                        'action': {
                                          'type': 'navigate',
                                          'args': {'target': 'library'},
                                        },
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'wrap',
                                    'gap': 8,
                                    'runGap': 8,
                                    'children': [
                                      {
                                        'type': 'chip',
                                        'label': 'Playlists',
                                        'action': {
                                          'type': 'navigate',
                                          'args': {'target': 'library'},
                                        },
                                      },
                                      {
                                        'type': 'chip',
                                        'label': 'Artists',
                                        'action': {
                                          'type': 'navigate',
                                          'args': {'target': 'library'},
                                        },
                                      },
                                      {
                                        'type': 'chip',
                                        'label': 'Albums',
                                        'action': {
                                          'type': 'navigate',
                                          'args': {'target': 'library'},
                                        },
                                      },
                                      {
                                        'type': 'chip',
                                        'label': 'Podcasts',
                                        'action': {
                                          'type': 'navigate',
                                          'args': {'target': 'library'},
                                        },
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'expanded',
                                    'flex': 1,
                                    'children': [
                                      {
                                        'type': 'scroll',
                                        'children': [
                                          // Spotify fills an empty library
                                          // with the two starter cards. They are
                                          // for the signed-out shell; a signed-in
                                          // library swaps them for the playlist
                                          // list below. A conditional is a
                                          // then/else pair, so the pair of cards
                                          // lives in one column.
                                          {
                                            'type': 'conditional',
                                            'bind': 'user.name',
                                            'invert': true,
                                            'children': [
                                              {
                                                'type': 'column',
                                                'gap': 8,
                                                'align': 'stretch',
                                                'children': [
                                                  {
                                                    'type': 'card',
                                                    'padding': 12,
                                                    'radius': 6,
                                                    'background': '@card',
                                                    'hoverBackground': '@accent',
                                                    'borderWidth': 0,
                                                    'action': {
                                                      'type': 'navigate',
                                                      'args': {'target': 'library'},
                                                    },
                                                    'children': [
                                                      {
                                                        'type': 'column',
                                                        'gap': 6,
                                                        'align': 'stretch',
                                                        'children': [
                                                          {
                                                            'type': 'text',
                                                            'text':
                                                                'Create your first playlist',
                                                            'size': 'sm',
                                                            'weight': 700,
                                                            'maxLines': 1,
                                                            'overflow': 'ellipsis',
                                                          },
                                                          {
                                                            'type': 'text',
                                                            'text':
                                                                "It's easy, we'll help you",
                                                            'size': 'xs',
                                                            'color':
                                                                '@mutedForeground',
                                                            'maxLines': 1,
                                                            'overflow': 'ellipsis',
                                                          },
                                                          {'type': 'gap', 'size': 6},
                                                          {
                                                            'type': 'row',
                                                            'children': [
                                                              {
                                                                'type': 'card',
                                                                'padding': 8,
                                                                'radius': 999,
                                                                'background':
                                                                    '#ffffff',
                                                                'hoverBackground':
                                                                    '#f6f6f6',
                                                                'borderWidth': 0,
                                                                'action': {
                                                                  'type': 'navigate',
                                                                  'args': {
                                                                    'target':
                                                                        'library'
                                                                  },
                                                                },
                                                                'children': [
                                                                  {
                                                                    'type': 'text',
                                                                    'text':
                                                                        'Create playlist',
                                                                    'size': 'xs',
                                                                    'weight': 700,
                                                                    'color': '#000000',
                                                                  },
                                                                ],
                                                              },
                                                              {
                                                                'type': 'spacer',
                                                                'flex': 1,
                                                              },
                                                            ],
                                                          },
                                                        ],
                                                      },
                                                    ],
                                                  },
                                                  {
                                                    'type': 'card',
                                                    'padding': 12,
                                                    'radius': 6,
                                                    'background': '@card',
                                                    'hoverBackground': '@accent',
                                                    'borderWidth': 0,
                                                    'action': {
                                                      'type': 'navigate',
                                                      'args': {'target': 'library'},
                                                    },
                                                    'children': [
                                                      {
                                                        'type': 'column',
                                                        'gap': 6,
                                                        'align': 'stretch',
                                                        'children': [
                                                          {
                                                            'type': 'text',
                                                            'text':
                                                                "Let's find some podcasts to follow",
                                                            'size': 'sm',
                                                            'weight': 700,
                                                            'maxLines': 1,
                                                            'overflow': 'ellipsis',
                                                          },
                                                          {
                                                            'type': 'text',
                                                            'text':
                                                                "We'll keep you updated on new episodes",
                                                            'size': 'xs',
                                                            'color':
                                                                '@mutedForeground',
                                                            'maxLines': 2,
                                                            'overflow': 'ellipsis',
                                                          },
                                                          {'type': 'gap', 'size': 6},
                                                          {
                                                            'type': 'row',
                                                            'children': [
                                                              {
                                                                'type': 'card',
                                                                'padding': 8,
                                                                'radius': 999,
                                                                'background':
                                                                    '#ffffff',
                                                                'hoverBackground':
                                                                    '#f6f6f6',
                                                                'borderWidth': 0,
                                                                'action': {
                                                                  'type': 'navigate',
                                                                  'args': {
                                                                    'target':
                                                                        'library'
                                                                  },
                                                                },
                                                                'children': [
                                                                  {
                                                                    'type': 'text',
                                                                    'text':
                                                                        'Browse podcasts',
                                                                    'size': 'xs',
                                                                    'weight': 700,
                                                                    'color': '#000000',
                                                                  },
                                                                ],
                                                              },
                                                              {
                                                                'type': 'spacer',
                                                                'flex': 1,
                                                              },
                                                            ],
                                                          },
                                                        ],
                                                      },
                                                    ],
                                                  },
                                                ],
                                              },
                                            ],
                                          },
                                          {
                                            // The host list is the signed-in
                                            // library. Mounting it while signed
                                            // out would ask the plugin for saved
                                            // playlists before there is an
                                            // account to ask about.
                                            'type': 'conditional',
                                            'bind': 'user.name',
                                            'children': [
                                              {
                                                'type': 'hostWidget',
                                                'id': 'library.playlists',
                                                'props': {
                                                  'compact': true,
                                                  'showSearch': true,
                                                  'showCreate': false,
                                                  'limit': 40,
                                                  'showPin': false,
                                                  'showQueue': false,
                                                  'showPlay': false,
                                                  'coverPlays': true,
                                                  'filter': 'recent',
                                                  'showSubtitle': false,
                                                  'density': 'compact',
                                                  'coverSize': 48,
                                                  'coverRadius': 4,
                                                  'showDividers': true,
                                                },
                                              },
                                            ],
                                          },
                                        ],
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'card',
                                    'padding': 4,
                                    'radius': 6,
                                    'background': '#00000000',
                                    'hoverBackground': '@sidebarAccent',
                                    'borderWidth': 0,
                                    'action': {
                                      'type': 'navigate',
                                      'args': {'target': 'profile'},
                                    },
                                    'children': [
                                      {
                                        'type': 'row',
                                        'gap': 8,
                                        'align': 'center',
                                        'children': [
                                          {
                                            'type': 'image',
                                            'src': 'user.avatar',
                                            'width': 28,
                                            'height': 28,
                                            'radius': 999,
                                            'shape': 'circle',
                                            'fit': 'cover',
                                          },
                                          {
                                            'type': 'button',
                                            'icon': 'settings',
                                            'variant': 'ghost',
                                            'size': 'small',
                                            'action': {'type': 'openSettings'},
                                          },
                                        ],
                                      },
                                    ],
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      // Collapse the sidebar into the cover-only
                      // rail. The host keeps the rail width and the
                      // divider; the theme draws what fits in it.
                      {
                        'type': 'button',
                        'icon': 'chevronLeft',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'toggleSidebar'},
                      },
                    ],
                  },
                ],
              },
            ],
          },

          'aside.content': {
            'children': [
              {
                'type': 'padding',
                'horizontal': 16,
                'top': 8,
                'bottom': 16,
                'children': [
                  {
                    'type': 'column',
                    'gap': 14,
                    'children': [
                      {
                        'type': 'row',
                        'align': 'center',
                        'children': [
                          {
                            'type': 'text',
                            'text': 'Now playing',
                            'size': 'xl',
                            'weight': 800,
                            'letterSpacing': -0.4,
                          },
                          {'type': 'spacer', 'flex': 1},
                          {
                            'type': 'button',
                            'icon': 'queue',
                            'variant': 'ghost',
                            'size': 'small',
                            'action': {'type': 'openQueue'},
                          },
                        ],
                      },
                      {
                        'type': 'conditional',
                        'bind': 'player.title',
                        'invert': true,
                        'children': [
                          {
                            'type': 'card',
                            'radius': 8,
                            'padding': 16,
                            'background': '@card',
                            'borderWidth': 0,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 4,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'Nothing playing',
                                    'size': 'md',
                                    'weight': 700,
                                  },
                                  {
                                    'type': 'text',
                                    'text':
                                        'Pick a song and the cover, credits and queue show up here.',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'conditional',
                        'bind': 'player.title',
                        'children': [
                          {
                            'type': 'column',
                            'gap': 10,
                            'align': 'stretch',
                            'children': [
                              {
                                'type': 'align',
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'image',
                                    'src': 'player.artwork',
                                    'width': 244,
                                    'height': 244,
                                    'radius': 8,
                                    'fit': 'cover',
                                  },
                                ],
                              },
                              {
                                'type': 'text',
                                'bind': 'player.title',
                                'size': 'xl',
                                'weight': 800,
                                'letterSpacing': -0.4,
                                'maxLines': 2,
                                'overflow': 'ellipsis',
                              },
                              {
                                'type': 'text',
                                'bind': 'player.artist',
                                'size': 'sm',
                                'color': '@mutedForeground',
                                'maxLines': 1,
                                'overflow': 'ellipsis',
                              },
                              {
                                'type': 'row',
                                'gap': 2,
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'conditional',
                                    'bind': 'player.liked',
                                    'children': [
                                      {
                                        'type': 'button',
                                        'icon': 'liked',
                                        'color': '@primary',
                                        'variant': 'ghost',
                                        'size': 'small',
                                        'action': {'type': 'like'},
                                      },
                                      {
                                        'type': 'button',
                                        'icon': 'like',
                                        'variant': 'ghost',
                                        'size': 'small',
                                        'action': {'type': 'like'},
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'button',
                                    'icon': 'download',
                                    'variant': 'ghost',
                                    'size': 'small',
                                    'action': {'type': 'download'},
                                  },
                                  {
                                    'type': 'button',
                                    'icon': 'queue',
                                    'variant': 'ghost',
                                    'size': 'small',
                                    'action': {'type': 'openQueue'},
                                  },
                                  {'type': 'spacer', 'flex': 1},
                                ],
                              },
                              {
                                'type': 'row',
                                'gap': 8,
                                'align': 'center',
                                'children': [
                                  {
                                    'type': 'text',
                                    'bind': 'player.position',
                                    'size': 'xs',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'expanded',
                                    'flex': 1,
                                    'children': [
                                      {
                                        'type': 'progress',
                                        'bind': 'player.position',
                                        'maxBind': 'player.duration',
                                        'height': 4,
                                        'hitHeight': 12,
                                        'radius': 999,
                                        'color': '@foreground',
                                        'trackColor': '#4d4d4d',
                                        'thumbColor': '@foreground',
                                        'thumbSize': 10,
                                        'interactive': true,
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'player.duration',
                                    'size': 'xs',
                                    'color': '@mutedForeground',
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
{
                        'type': 'conditional',
                        'bind': 'player.title',
                        'children': [
                          {
                            'type': 'column',
                            'gap': 14,
                            'align': 'stretch',
                            'children': [
                                                  {
                                                    'type': 'divider',
                                                    'orientation': 'horizontal',
                                                    'thickness': 1,
                                                    'color': '@palette.darkMuted',
                                                  },
                                                  {
                                                    'type': 'column',
                                                    'gap': 8,
                                                    'children': [
                                                      {
                                                        'type': 'text',
                                                        'text': 'Next up',
                                                        'size': 'xs',
                                                        'color': '@mutedForeground',
                                                        'uppercase': true,
                                                        'letterSpacing': 1.2,
                                                      },
                                                      {
                                                        'type': 'conditional',
                                                        'bind': 'queue.next',
                                                        'children': [
                                                          {
                                                            'type': 'card',
                                                            'padding': 6,
                                                            'radius': 6,
                                                            'background': '#00000000',
                                                            'hoverBackground': '@secondary',
                                                            'borderWidth': 0,
                                                            'action': {'type': 'openQueue'},
                                                            'children': [
                                                              {
                                                                'type': 'row',
                                                                'gap': 10,
                                                                'align': 'center',
                                                                'children': [
                                                                  {
                                                                    'type': 'image',
                                                                    'src': 'queue.next.artwork',
                                                                    'width': 44,
                                                                    'height': 44,
                                                                    'radius': 4,
                                                                    'fit': 'cover',
                                                                  },
                                                                  {
                                                                    'type': 'expanded',
                                                                    'flex': 1,
                                                                    'children': [
                                                                      {
                                                                        'type': 'column',
                                                                        'gap': 2,
                                                                        'children': [
                                                                          {
                                                                            'type': 'text',
                                                                            'bind': 'queue.next.title',
                                                                            'size': 'sm',
                                                                            'weight': 600,
                                                                            'maxLines': 1,
                                                                            'overflow': 'ellipsis',
                                                                          },
                                                                          {
                                                                            'type': 'text',
                                                                            'bind': 'queue.next.artist',
                                                                            'size': 'xs',
                                                                            'color': '@mutedForeground',
                                                                            'maxLines': 1,
                                                                            'overflow': 'ellipsis',
                                                                          },
                                                                        ],
                                                                      },
                                                                    ],
                                                                  },
                                                                ],
                                                              },
                                                            ],
                                                          },
                                                        ],
                                                      },
                                                      {
                                                        'type': 'conditional',
                                                        'bind': 'queue.next',
                                                        'invert': true,
                                                        'children': [
                                                          {
                                                            'type': 'text',
                                                            'text': 'Nothing queued after this track.',
                                                            'size': 'sm',
                                                            'color': '@mutedForeground',
                                                          },
                                                        ],
                                                      },
                                                    ],
                                                  },
                                                  {
                                                    'type': 'row',
                                                    'align': 'center',
                                                    'justify': 'spaceBetween',
                                                    'children': [
                                                      {
                                                        'type': 'column',
                                                        'gap': 2,
                                                        'children': [
                                                          {
                                                            'type': 'text',
                                                            'text': 'In queue',
                                                            'size': 'xs',
                                                            'color': '@mutedForeground',
                                                            'uppercase': true,
                                                            'letterSpacing': 1.2,
                                                          },
                                                          {
                                                            'type': 'row',
                                                            'gap': 4,
                                                            'align': 'center',
                                                            'children': [
                                                              {
                                                                'type': 'text',
                                                                'bind': 'queue.count',
                                                                'size': 'sm',
                                                                'weight': 700,
                                                              },
                                                              {
                                                                'type': 'text',
                                                                'text': 'songs',
                                                                'size': 'sm',
                                                                'color': '@mutedForeground',
                                                              },
                                                            ],
                                                          },
                                                        ],
                                                      },
                                                      {
                                                        'type': 'button',
                                                        'label': 'Open queue',
                                                        'variant': 'outline',
                                                        'size': 'small',
                                                        'action': {'type': 'openQueue'},
                                                      },
                                                    ],
                                                  },
                            ],
                          },
                        ],
                      },
                      // The reference keeps a short artist panel under the
                      // queue block. There is no artist-page binding, so this
                      // card names the act and stays a surface rather than
                      // pretending to be a link.
                      {
                        'type': 'conditional',
                        'bind': 'player.title',
                        'children': [
                          {
                            'type': 'box',
                            'background': '@card',
                            'radius': 8,
                            'padding': 12,
                            'children': [
                              {
                                'type': 'column',
                                'gap': 4,
                                'children': [
                                  {
                                    'type': 'text',
                                    'text': 'About the artist',
                                    'size': 'xs',
                                    'color': '@mutedForeground',
                                    'uppercase': true,
                                    'letterSpacing': 1.2,
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'player.artist',
                                    'size': 'lg',
                                    'weight': 800,
                                    'maxLines': 2,
                                    'overflow': 'ellipsis',
                                  },
                                  {
                                    'type': 'text',
                                    'text': 'Artist',
                                    'size': 'xs',
                                    'color': '@mutedForeground',
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },


          // Spotify's now-playing strip: a 56px cover, then the two lines of
          // track metadata. The host keeps the transport and the right-side
          // actions so their live state and tooltips stay intact.
          'player.leading': {
            'children': [
              {
                'type': 'row',
                'gap': 14,
                'align': 'center',
                'children': [
                  {
                    'type': 'image',
                    'src': 'player.artwork',
                    'width': 56,
                    'height': 56,
                    'radius': 4,
                    'fit': 'cover',
                  },
                  {
                    'type': 'expanded',
                    'flex': 1,
                    'children': [
                      {
                        'type': 'column',
                        'gap': 2,
                        'children': [
                          {
                            'type': 'text',
                            'bind': 'player.title',
                            'size': 'sm',
                            'weight': 600,
                            'maxLines': 1,
                            'overflow': 'ellipsis',
                          },
                          {
                            'type': 'text',
                            'bind': 'player.artist',
                            'size': 'xs',
                            'color': '@mutedForeground',
                            'maxLines': 1,
                            'overflow': 'ellipsis',
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // Spotify's transport: compact controls with the seek line under
          // them. The host's stock transport reserved ~140px for the footer;
          // the theme keeps the same verbs and data but sizes the bar like
          // the reference.
          'player.controls': {
            'children': [
              {
                'type': 'column',
                'gap': 6,
                'children': [
                  {
                    'type': 'row',
                    'gap': 16,
                    'align': 'center',
                    'justify': 'center',
                    'children': [
                      {
                        'type': 'button',
                        'icon': 'shuffle',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'setShuffle'},
                      },
                      {
                        'type': 'button',
                        'icon': 'previous',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'previous'},
                      },
                      {
                        'type': 'card',
                        'width': 36,
                        'height': 36,
                        'padding': 0,
                        'radius': 999,
                        'background': '@primary',
                        'hoverBackground': '#1fdf64',
                        'borderWidth': 0,
                        'action': {'type': 'playPause'},
                        'children': [
                          {
                            'type': 'align',
                            'align': 'center',
                            'children': [
                              {
                                'type': 'conditional',
                                'bind': 'player.playing',
                                'children': [
                                  {
                                    'type': 'icon',
                                    'icon': 'pause',
                                    'size': 18,
                                    'color': '@primaryForeground',
                                  },
                                  {
                                    'type': 'icon',
                                    'icon': 'play',
                                    'size': 18,
                                    'color': '@primaryForeground',
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                      {
                        'type': 'button',
                        'icon': 'next',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'next'},
                      },
                      {
                        'type': 'conditional',
                        'bind': 'player.loop',
                        'equals': 'single',
                        'children': [
                          {
                            'type': 'button',
                            'icon': 'repeatOne',
                            'variant': 'ghost',
                            'size': 'small',
                            'action': {'type': 'setLoopMode'},
                          },
                          {
                            'type': 'button',
                            'icon': 'repeat',
                            'variant': 'ghost',
                            'size': 'small',
                            'action': {'type': 'setLoopMode'},
                          },
                        ],
                      },
                    ],
                  },
                  {
                    'type': 'row',
                    'gap': 8,
                    'align': 'center',
                    'children': [
                      {
                        'type': 'text',
                        'bind': 'player.position',
                        'size': 'xs',
                        'color': '@mutedForeground',
                      },
                      {
                        'type': 'expanded',
                        'flex': 1,
                        'children': [
                          {
                            'type': 'progress',
                            'bind': 'player.position',
                            'maxBind': 'player.duration',
                            'height': 4,
                            'hitHeight': 12,
                            'radius': 999,
                            'color': '@foreground',
                            'trackColor': '#4d4d4d',
                            'thumbColor': '@foreground',
                            'thumbSize': 10,
                            'interactive': true,
                          },
                        ],
                      },
                      {
                        'type': 'text',
                        'bind': 'player.duration',
                        'size': 'xs',
                        'color': '@mutedForeground',
                      },
                    ],
                  },
                ],
              },
            ],
          },

          // Spotify's right-hand transport cluster: one line of icon actions
          // rather than the host's default actions stacked over a volume
          // slider. The host still owns every underlying state.
          'player.trailing': {
            'children': [
              {
                'type': 'row',
                'gap': 2,
                'align': 'center',
                'children': [
                  {
                    'type': 'conditional',
                    'bind': 'player.liked',
                    'children': [
                      {
                        'type': 'button',
                        'icon': 'liked',
                        'color': '@primary',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'like'},
                      },
                      {
                        'type': 'button',
                        'icon': 'like',
                        'variant': 'ghost',
                        'size': 'small',
                        'action': {'type': 'like'},
                      },
                    ],
                  },
                  {
                    'type': 'button',
                    'icon': 'download',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'download'},
                  },
                  {
                    'type': 'button',
                    'icon': 'lyrics',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'openLyrics'},
                  },
                  {
                    'type': 'button',
                    'icon': 'queue',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'openQueue'},
                  },
                  {
                    'type': 'button',
                    'icon': 'volume',
                    'variant': 'ghost',
                    'size': 'small',
                    'action': {'type': 'setMuted'},
                  },
                ],
              },
            ],
          },

          // The whole home body, because the theme draws its own top bar.
          'home.content': {
            'children': [
              {
                'type': 'column',
                'align': 'stretch',
                'children': [
                {
                  'type': 'padding',
                  'horizontal': 24,
                  'top': 12,
                  'bottom': 4,
                  'children': [
                    {
                      'type': 'row',
                      'gap': 8,
                      'align': 'center',
                      'children': [
                        {
                          'type': 'button',
                          'icon': 'home',
                          'variant': 'ghost',
                          'size': 'md',
                          'action': {
                            'type': 'navigate',
                            'args': {'target': 'home'},
                          },
                        },
                        {
                          'type': 'button',
                          'icon': 'radio',
                          'variant': 'ghost',
                          'size': 'md',
                          'action': {
                            'type': 'navigate',
                            'args': {'target': 'radio'},
                          },
                        },
                        // Keep the search field reference-sized instead of
                        // letting it eat the whole top bar.
                        {'type': 'spacer', 'flex': 2},
                        {
                          'type': 'expanded',
                          'flex': 3,
                          'children': [
                            {
                              'type': 'card',
                              'height': 40,
                              'padding': 0,
                              'radius': 999,
                              'background': '@secondary',
                              'hoverBackground': '@accent',
                              'borderWidth': 0,
                              'children': [
                                {
                                  'type': 'search',
                                  'placeholder': 'What do you want to play?',
                                },
                              ],
                            },
                          ],
                        },
                        {'type': 'spacer', 'flex': 2},
                        {
                          'type': 'button',
                          'icon': 'settings',
                          'variant': 'ghost',
                          'size': 'md',
                          'action': {'type': 'openSettings'},
                        },
                        {
                          'type': 'button',
                          'icon': 'download',
                          'variant': 'ghost',
                          'size': 'md',
                          'action': {'type': 'openDownloads'},
                        },
                        {
                          'type': 'image',
                          'src': 'user.avatar',
                          'width': 32,
                          'height': 32,
                          'radius': 999,
                          'shape': 'circle',
                          'fit': 'cover',
                          'action': {
                            'type': 'navigate',
                            'args': {'target': 'profile'},
                          },
                        },
                      ],
                    },
                  ],
                },
                {
                  'type': 'padding',
                  'horizontal': 24,
                  'top': 8,
                  'bottom': 4,
                  'children': [
                    {
                      'type': 'text',
                      'bind': 'app.greeting',
                      'size': '2xl',
                      'weight': 800,
                      'letterSpacing': -0.8,
                    },
                  ],
                },
                {
                  // Spotify opens with six shortcuts in a 3x2 matrix. This is
                  // the same bound recent feed the shelves use, wrapped by the
                  // v4 `columns` list mode so it stays data-driven.
                  'type': 'conditional',
                  'bind': 'home.hasRecent',
                  'equals': true,
                  'children': [
                    {
                      'type': 'padding',
                      'horizontal': 24,
                      'top': 8,
                      'bottom': 4,
                      'children': [
                        {
                          'type': 'list',
                          'bind': 'home.recent',
                          'columns': {'compact': 2, 'medium': 2, 'expanded': 4},
                          'gap': 8,
                          'limit': 4,
                          'align': 'stretch',
                          'children': [
                            {
                              'type': 'card',
                              'height': 56,
                              'padding': 0,
                              'radius': 4,
                              'background': '@card',
                              'hoverBackground': '@accent',
                              'borderWidth': 0,
                              'action': {'type': 'openItem'},
                              'children': [
                                {
                                  'type': 'row',
                                  'align': 'center',
                                  'children': [
                                    {
                                      'type': 'image',
                                      'src': 'item.artwork',
                                      'width': 56,
                                      'height': 56,
                                      'radius': 4,
                                      'fit': 'cover',
                                    },
                                    {
                                      'type': 'expanded',
                                      'flex': 1,
                                      'children': [
                                        {
                                          'type': 'padding',
                                          'horizontal': 12,
                                          'children': [
                                            {
                                              'type': 'text',
                                              'bind': 'item.title',
                                              'size': 'sm',
                                              'weight': 700,
                                              'maxLines': 1,
                                              'overflow': 'ellipsis',
                                            },
                                          ],
                                        },
                                      ],
                                    },
                                  ],
                                },
                              ],
                            },
                          ],
                        },
                      ],
                    },
                  ],
                },
                {
                  // `home.content` replaces the host's body, including its
                  // anonymous fallback. Without this panel a signed-out user
                  // gets a top bar over an empty page, because every section
                  // below is conditional on data only an account can supply.
                  'type': 'conditional',
                  'bind': 'user.name',
                  'invert': true,
                  'children': [
                    {
                      'type': 'padding',
                      'horizontal': 24,
                      'top': 8,
                      'children': [
                        {
                          'type': 'card',
                          'padding': 20,
                          'radius': 8,
                          'background': '@card',
                          'borderWidth': 0,
                          'children': [
                            {
                              'type': 'column',
                              'gap': 8,
                              'children': [
                                {
                                  'type': 'text',
                                  'text': 'Sign in to listen',
                                  'size': 'xl',
                                  'weight': 800,
                                  'letterSpacing': -0.4,
                                },
                                {
                                  'type': 'text',
                                  'text': 'Connect your Spotify account from Settings → Metadata plugins.',
                                  'size': 'sm',
                                  'color': '@mutedForeground',
                                },
                                {'type': 'gap', 'size': 8},
                                {
                                  'type': 'button',
                                  'label': 'Open settings',
                                  'variant': 'primary',
                                  'size': 'small',
                                  'action': {'type': 'openSettings'},
                                },
                              ],
                            },
                          ],
                        },
                      ],
                    },
                  ],
                },
                {
                  'type': 'conditional',
                  'bind': 'home.hasNewReleases',
                  'equals': true,
                  'children': [
                    {
                      'type': 'padding',
                      'horizontal': 24,
                      'top': 20,
