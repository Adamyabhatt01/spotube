            ],
          },

          // Albums, playlists and liked songs.
          'collection.content': {
            'children': [
              // Spotify paints the collection header with the cover's own
              // colour and lets it fall back into the page background. The
              // page scope carries `collection.artwork`, so the palette
              // resolves here without the theme naming a colour.
              {
                'type': 'box',
                'gradient': {
                  'colors': ['@palette.darkMuted', '@background'],
                  'begin': 'topCenter',
                  'end': 'bottomCenter',
                  'stops': [0.0, 1.0],
                },
                'padding': 24,
                'children': [
                  {
                    'type': 'row',
                    'gap': 24,
                    'align': 'end',
                    'children': [
                      {
                        'type': 'image',
                        'src': 'collection.artwork',
                        'width': 232,
                        'height': 232,
                        'radius': 4,
                        'fit': 'cover',
                      },
                      {
                        'type': 'expanded',
                        'flex': 1,
                        'children': [
                          {
                            'type': 'column',
                            'gap': 10,
                            'children': [
                              {
                                'type': 'text',
                                'bind': 'collection.kind',
                                'size': 'xs',
                                'weight': 700,
                                'uppercase': true,
                                'letterSpacing': 1.2,
                              },
                              {
                                'type': 'text',
                                'bind': 'collection.title',
                                'size': '6xl',
                                'weight': 900,
                                'letterSpacing': -2.0,
                                'maxLines': 2,
                                'overflow': 'ellipsis',
                              },
                              {
                                'type': 'conditional',
                                'bind': 'collection.kind',
                                'equals': 'playlist',
                                'children': [
                                  {
                                    'type': 'text',
                                    'bind': 'collection.description',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                    'maxLines': 2,
                                    'overflow': 'ellipsis',
                                  },
                                ],
                              },
                              {
                                'type': 'wrap',
                                'gap': 8,
                                'runGap': 2,
                                'align': 'center',
                                'justify': 'start',
                                'children': [
                                  {
                                    'type': 'conditional',
                                    'bind': 'collection.ownerImage',
                                    'children': [
                                      {
                                        'type': 'image',
                                        'src': 'collection.ownerImage',
                                        'width': 24,
                                        'height': 24,
                                        'radius': 999,
                                        'shape': 'circle',
                                        'fit': 'cover',
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'collection.owner',
                                    'size': 'sm',
                                    'weight': 700,
                                  },
                                  {
                                    'type': 'conditional',
                                    'bind': 'collection.year',
                                    'children': [
                                      {
                                        'type': 'row',
                                        'gap': 8,
                                        'align': 'center',
                                        'children': [
                                          {
                                            'type': 'text',
                                            'text': '•',
                                            'size': 'sm',
                                            'color': '@mutedForeground',
                                          },
                                          {
                                            'type': 'text',
                                            'bind': 'collection.year',
                                            'size': 'sm',
                                            'color': '@mutedForeground',
                                          },
                                        ],
                                      },
                                    ],
                                  },
                                  {
                                    'type': 'text',
                                    'text': '•',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'text',
                                    'bind': 'collection.trackCount',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'text',
                                    'text': 'songs',
                                    'size': 'sm',
                                    'color': '@mutedForeground',
                                  },
                                  {
                                    'type': 'conditional',
                                    'bind': 'collection.duration',
                                    'children': [
                                      {
                                        'type': 'row',
                                        'gap': 8,
                                        'align': 'center',
                                        'children': [
                                          {
                                            'type': 'text',
                                            'text': '•',
                                            'size': 'sm',
                                            'color': '@mutedForeground',
                                          },
                                          {
                                            'type': 'text',
                                            'bind': 'collection.duration',
                                            'size': 'sm',
                                            'color': '@mutedForeground',
                                          },
                                        ],
                                      },
                                    ],
                                  },
                                ],
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
              {
                'type': 'padding',
                'horizontal': 24,
                'top': 18,
                'bottom': 10,
                'children': [
                  {
                    'type': 'row',
                    'gap': 12,
                    'align': 'center',
